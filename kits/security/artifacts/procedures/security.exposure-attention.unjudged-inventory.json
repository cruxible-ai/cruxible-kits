      }
    },
    "description": "Post one inbox item per exposure in the Line's inventory that nobody has judged and whose vulnerability is KEV-listed, has an EPSS score at or above min_epss, or has no EPSS score yet (security.inventory_unjudged_exposures_over); KEV-listed first, then by EPSS score.",
    "hard_caps": {
      "max_capture_bytes": 0,
      "max_items": 20000,
      "max_provider_calls": 0,
      "max_read_rows": 50000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.exposure-attention.unjudged-inventory",
    "nodes": [
      {
        "fields": {},
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "pairs",
        "kind": "read",
        "parameters": {
          "inventory": "$params.inventory",
          "min_epss": "$params.min_epss"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.inventory_unjudged_exposures_over"
          }
        }
      },
      {
        "contract": {
          "digest": "sha256:ab0f2fc68ca9908c9ec5956a9faa05865c461cbd64280e1e04607d69f9371515",
          "name": "security.exposure-attention",
          "version": 2
        },
