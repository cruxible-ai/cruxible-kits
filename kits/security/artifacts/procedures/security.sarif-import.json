{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security.sarif-import.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security.sarif-import.output/v1"
      }
    },
    "description": "Read one SARIF file from the workspace and write the findings it reports for the Line's repository; a full scan verifies fixes.",
    "hard_caps": {
      "max_capture_bytes": 33554432,
      "max_items": 100000,
      "max_provider_calls": 2,
      "max_read_rows": 20000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.sarif-import",
    "nodes": [
      {
        "id": "held",
        "kind": "read",
        "parameters": {
          "repo": "$params.repo"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.sarif_held_findings"
          }
        }
      },
      {
        "captures": {
          "capture": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.sarif-log"
            }
          }
        },
        "id": "sarif",
        "input": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "$params.logical_source",
          "relative_path": "$params.relative_path",
          "replayability": "attested_only",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        },
        "kind": "call",
        "slot": "read"
      },
      {
        "captures": {
          "document": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.sarif-findings"
            }
          }
        },
        "id": "findings",
        "input": {
          "held": "$steps.held.rows",
          "logical_source": "$params.logical_source",
          "logs": [
            "$steps.sarif.capture"
          ],
          "repo": "$params.repo"
        },
        "kind": "call",
        "slot": "derive"
      },
      {
        "capture": "$steps.findings.document",
        "complete_when": {
          "count_at": "/count"
        },
        "fields": {
          "reported_at": {
            "at": "reported_at",
            "presence": "optional"
          },
          "rule": {
            "at": "rule",
            "presence": "optional"
          },
          "severity": {
            "at": "severity",
            "presence": "optional"
          },
          "tool": {
            "at": "tool",
            "presence": "optional"
          },
          "verification": {
            "at": "verification"
          }
        },
        "header": {
          "covered": {
            "at": "/covered",
            "type": "list<string{max_len: 256}>{max_items: 20000}"
          }
        },
        "id": "found",
        "key": {
          "locus": {
            "at": "locus",
            "type": "key_part<security.finding:locus>"
          },
          "repo": {
            "at": "repo",
            "type": "key_part<security.finding:repo>"
          },
          "weakness": {
            "at": "weakness",
            "type": "key_part<security.finding:weakness>"
          }
        },
        "kind": "extract",
        "records": "/findings/*",
        "row": {
          "digest": "sha256:89b733667e5379af29230e496b5bf182942cb251b0891be100444d3ed82b7d91",
          "name": "security.sarif-finding",
          "version": 1
        }
      },
      {
        "claims": [
          {
            "rationale": "{$item.fields.rule} reports {$item.key.weakness} here.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.finding.rule"
              }
            },
            "value": "$item.fields.rule",
            "when_absent": "keep"
          },
          {
            "rationale": "{$item.fields.tool} reports {$item.key.weakness} here.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.finding.reported_by"
              }
            },
            "value": "$item.fields.tool",
            "when_absent": "keep"
          },
          {
            "rationale": "{$item.fields.rule} rates it {$item.fields.severity}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.finding.severity"
              }
            },
            "value": "$item.fields.severity",
            "when_absent": "keep"
          },
          {
            "rationale": "The scan reports it at {$item.fields.reported_at}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.finding.reported_at"
              }
            },
            "value": "$item.fields.reported_at",
            "when_absent": "mirror"
          },
          {
            "rationale": "The scan of {$params.relative_path} reads it {$item.fields.verification}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.finding.verification"
              }
            },
            "value": "$item.fields.verification",
            "when_absent": "keep"
          }
        ],
        "expect": "$steps.found.header.covered",
        "for_each": "$steps.found.records",
        "id": "write",
        "kind": "claims",
        "subject": {
          "create": "if_absent",
          "key": {
            "locus": "$item.key.locus",
            "repo": "$item.key.repo",
            "weakness": "$item.key.weakness"
          },
          "kind": "security.finding"
        }
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "security.sarif-import.params/v2"
      }
    },
    "slots": {
      "derive": {
        "effect": "pure",
        "in": {
          "digest": "sha256:62938ed7aeaf7058e926661779c7aa3582a72d93ec1510b22cc0b25933e358ee",
          "name": "sarif.findings.request",
          "version": 1
        },
        "out": {
          "digest": "sha256:4ebc62f6842e6c7ff59360554d4a249fd33ae614a8368654eced2a8cd14fd2b9",
          "name": "sarif.findings.result",
          "version": 1
        }
      },
      "read": {
        "effect": "pure",
        "in": {
          "digest": "sha256:d9c33d4ac151700c89f5391b66adf73c6e6cddfc199670cd4cb9dc01651f7240",
          "name": "workspace.file.request",
          "version": 1
        },
        "out": {
          "digest": "sha256:fe3980a054beed0610045a28a27fbb50c0bad89e91fb5059a76667e34e169dd8",
          "name": "workspace.file.result",
          "version": 1
        }
      }
    },
    "terminal_capability": 3
  },
  "definition_digest": "sha256:fff06fa6d4509d355074eb64be4f3a8d48c140b60b7aed1357710201da25a241",
  "identity": {
    "kind": "Procedure",
    "name": "security.sarif-import"
  }
}
