{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security.epss-triage.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security.epss-triage.output/v1"
      }
    },
    "description": "Ask FIRST's EPSS API for the watched CVEs and write each one's score, percentile and score date.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 20000,
      "max_provider_calls": 1,
      "max_read_rows": 50000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.epss-triage",
    "nodes": [
      {
        "id": "watched",
        "kind": "read",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.watched_vulnerabilities"
          }
        }
      },
      {
        "id": "watch_keys",
        "kind": "read",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.watched_cve_keys"
          }
        }
      },
      {
        "captures": {
          "captures": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.epss-scores"
            }
          }
        },
        "id": "scores_api",
        "input": {
          "expected_format": "json",
          "logical_source": "$params.logical_source",
          "max_bytes": "$params.max_bytes",
          "max_url_chars": 1438,
          "page_param": "cve",
          "query": [
            {
              "join": "comma",
              "name": "cve",
              "values": "$steps.watch_keys.rows.[*].cve_id"
            }
          ],
          "url": "$params.url"
        },
        "kind": "call",
        "slot": "fetch"
      },
      {
        "capture": "$steps.scores_api.captures",
        "id": "scores",
        "kind": "extract",
        "only_keys": "$steps.watch_keys.rows",
        "records": "scores",
        "row": {
          "digest": "sha256:7a1bbf372233a0b23b10b0623d43096d01efb524019beaf8f6ae742a363f17b8",
          "name": "security.epss-row",
          "version": 1
        }
      },
      {
        "claims": [
          {
            "rationale": "FIRST EPSS on {$item.fields.date}: epss {$item.fields.score}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.epss_score"
              }
            },
            "value": "$item.fields.score"
          },
          {
            "rationale": "FIRST EPSS on {$item.fields.date}: percentile {$item.fields.percentile}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.epss_percentile"
              }
            },
            "value": "$item.fields.percentile"
          },
          {
            "rationale": "FIRST EPSS scored this CVE on {$item.fields.date}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.epss_score_date"
              }
            },
            "value": "$item.fields.date"
          }
        ],
        "for_each": "$steps.scores.records",
        "id": "write",
        "kind": "claims",
        "subject": {
          "key": {
            "cve_id": "$item.key.cve_id"
          },
          "kind": "security.vulnerability",
          "within": "$steps.watched.rows"
        }
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "security.epss-triage.params/v2"
      }
    },
    "slots": {
      "fetch": {
        "capability": {
          "digest": "sha256:b8452ca24e8b140b7ac4d6fc8e8cc41f3008208d6c6cf4230973aadca4a0eaad",
          "name": "web.fetch.pages",
          "version": 1
        }
      }
    },
    "terminal_capability": 3
  },
  "definition_digest": "sha256:62b8cb777d6aedba8605f8fa78d075000cae6a10cb9fc7cf4c4b9e7c1a5c2da7",
  "identity": {
    "kind": "Procedure",
    "name": "security.epss-triage"
  }
}
