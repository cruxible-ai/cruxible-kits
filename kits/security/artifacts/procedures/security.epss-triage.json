{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 33554432,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-empty-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-epss-summary"
      }
    },
    "description": "Read the EPSS daily file Capture that triggered the Line (security.fetched-v1) and the watched vulnerabilities, and settle epss_score and epss_percentile for each watched CVE whose scores changed, exactly as the file states them (or propose them under a propose cap). Halts no_change when nothing changed. Runs as a Line with trigger_input epss.",
    "hard_caps": {
      "max_capture_bytes": 33554432,
      "max_items": 5000,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.epss-triage",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.fetched-v1"
          }
        },
        "id": "epss",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.epss-daily/v1"
          }
        },
        "kind": "source",
        "provider": {
          "slot_name": "epss"
        },
        "request": {}
      },
      {
        "id": "watched",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.watched_vulnerabilities"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "daily_base64": "$steps.epss.retrieved.body_base64",
          "watched": "$steps.watched.result.rows"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.epss-scores/v1"
          }
        },
        "kind": "call",
        "provider": {
          "slot_name": "parse"
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-epss-summary"
          }
        },
        "fields": {
          "changed": "$steps.parse.changed",
          "model_version": "$steps.parse.model_version",
          "score_date": "$steps.parse.score_date",
          "scored": "$steps.parse.scored",
          "watched": "$steps.parse.watched"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "changed",
        "kind": "guard",
        "message": "The EPSS file changes no watched Claim.",
        "on_false": "nochange",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "changed"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "no_change"
      },
      {
        "candidate_templates": {
          "items": "$steps.parse.items"
        },
        "id": "settle",
        "kind": "settle_change_set",
        "result": "$steps.summary"
      },
      {
        "id": "nochange",
        "kind": "halt",
        "reason": "no_change"
      }
    ],
    "pin_slots": [
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.epss-daily/v1"
          }
        },
        "slot_name": "epss"
      },
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.epss-scores/v1"
          }
        },
        "slot_name": "parse"
      }
    ],
    "returns": "summary",
    "terminal_capability": 3
  },
  "definition_digest": "sha256:f76de64a94e928cda18ffa72352d3d13175a21c851060f8df65cbc5eed6da078",
  "identity": {
    "kind": "Procedure",
    "name": "security.epss-triage"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-empty-input"
      },
      "schema": {
        "fields": {}
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-epss-summary"
      },
      "schema": {
        "fields": {
          "changed": {
            "type": "integer"
          },
          "model_version": {
            "type": "string"
          },
          "score_date": {
            "type": "string"
          },
          "scored": {
            "type": "integer"
          },
          "watched": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
