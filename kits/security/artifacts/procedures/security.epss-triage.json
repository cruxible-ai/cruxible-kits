{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security.epss-triage.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security.epss-triage.output/v1"
      }
    },
    "description": "Read FIRST's EPSS API answer for the watched CVEs and write each one's score, percentile and score date.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 20000,
      "max_provider_calls": 1,
      "max_read_rows": 50000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.epss-triage",
    "nodes": [
      {
        "captures": {
          "capture": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.epss-scores"
            }
          }
        },
        "id": "scores_api",
        "input": {
          "expected_format": "json",
          "logical_source": "$params.logical_source",
          "max_bytes": "$params.max_bytes",
          "url": "$params.url"
        },
        "kind": "call",
        "slot": "fetch"
      },
      {
        "id": "watched",
        "kind": "read",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.watched_vulnerabilities"
          }
        }
      },
      {
        "id": "watch_keys",
        "kind": "read",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.watched_cve_keys"
          }
        }
      },
      {
        "capture": "$steps.scores_api.capture",
        "complete_when": {
          "count_at": "/total"
        },
        "fields": {
          "date": {
            "at": "date",
            "parse": "date"
          },
          "percentile": {
            "at": "percentile",
            "parse": "decimal"
          },
          "score": {
            "at": "epss",
            "parse": "decimal"
          }
        },
        "id": "scores",
        "key": {
          "cve_id": {
            "at": "cve",
            "type": "key_part<security.vulnerability:cve_id>"
          }
        },
        "kind": "extract",
        "only_keys": "$steps.watch_keys.rows",
        "records": "/data/*",
        "row": {
          "digest": "sha256:c87071597d8c0acb652d8bed03018de5134311ee844347548fa38939be0a2782",
          "name": "security.epss-row",
          "version": 1
        }
      },
      {
        "claims": [
          {
            "rationale": "FIRST EPSS on {$item.fields.date}: epss {$item.fields.score}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.epss_score"
              }
            },
            "value": "$item.fields.score"
          },
          {
            "rationale": "FIRST EPSS on {$item.fields.date}: percentile {$item.fields.percentile}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.epss_percentile"
              }
            },
            "value": "$item.fields.percentile"
          },
          {
            "rationale": "FIRST EPSS scored this CVE on {$item.fields.date}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.epss_score_date"
              }
            },
            "value": "$item.fields.date"
          }
        ],
        "for_each": "$steps.scores.records",
        "id": "write",
        "kind": "claims",
        "subject": {
          "key": {
            "cve_id": "$item.key.cve_id"
          },
          "kind": "security.vulnerability",
          "within": "$steps.watched.rows"
        }
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "security.epss-triage.params/v1"
      }
    },
    "slots": {
      "fetch": {
        "effect": "external_read",
        "in": {
          "digest": "sha256:1f4eefbeef292080ab075e22d068a4e45f6b01170802f2ca470daa2329444137",
          "name": "web.fetch.request",
          "version": 1
        },
        "out": {
          "digest": "sha256:94f256cdc9f9dfb45d8ac2a55e5aaf40bdb64757cbbf21703baeb8bd8d03062f",
          "name": "web.fetch.result",
          "version": 1
        }
      }
    },
    "terminal_capability": 3
  },
  "definition_digest": "sha256:ef594b40778fc417016ad1eb89f1a759e5e1dfddc22220b660dcde28c13c9dff",
  "identity": {
    "kind": "Procedure",
    "name": "security.epss-triage"
  }
}
