{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 16777216,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-repo-parse-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-repo-parse-summary"
      }
    },
    "description": "Read the repository snapshot that triggered the Line (security.fetched-v1) for the Line's source (parameters: source, repo_source, forge_host, full_name, ref, scope, path) and propose what changed: workflows, jobs and their triggers, permissions, secrets, environment, actions and publish targets, or a manifest's declared digests, plus the source's coverage restated (an unchanged snapshot re-observes it; a new revision revises it). Halts other_source for another source's snapshot. Runs as a Line with trigger_input snapshot.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 5000,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.repo-parse",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.fetched-v1"
          }
        },
        "id": "snapshot",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.repo-snapshot/v2"
          }
        },
        "kind": "source",
        "provider": {
          "slot_name": "snapshot"
        },
        "request": {
          "forge_host": "$input.forge_host",
          "full_name": "$input.full_name",
          "path": "$input.path",
          "ref": "$input.ref",
          "scope": "$input.scope"
        }
      },
      {
        "id": "mine",
        "kind": "guard",
        "message": "The landed snapshot is another source's.",
        "on_false": "other",
        "predicate": {
          "left": {
            "alias": "snapshot",
            "kind": "step",
            "path": [
              "locator"
            ]
          },
          "operator": "eq",
          "right": {
            "input_name": "source",
            "kind": "input"
          }
        },
        "refusal_code": "other_source"
      },
      {
        "id": "coverage",
        "kind": "state_tap",
        "parameters": {
          "scope": "$input.scope",
          "source": "$input.source"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.coverage_index"
          }
        }
      },
      {
        "id": "held",
        "kind": "state_tap",
        "parameters": {
          "source": "$input.repo_source"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.source_facts"
          }
        }
      },
      {
        "id": "targets",
        "kind": "state_tap",
        "parameters": {
          "forge_host": "$input.forge_host",
          "full_name": "$input.full_name"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.repo_targets"
          }
        }
      },
      {
        "id": "releases",
        "kind": "state_tap",
        "parameters": {
          "name": "$input.full_name",
          "registry": "github_release"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.registry_facts"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "coverage": "$steps.coverage.result.rows",
          "held": "$steps.held.result.rows",
          "releases": "$steps.releases.result.rows",
          "snapshot": "$steps.snapshot",
          "targets": "$steps.targets.result.rows"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.workflow-facts/v1"
          }
        },
        "kind": "call",
        "provider": {
          "slot_name": "parse"
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-repo-parse-summary"
          }
        },
        "fields": {
          "added": "$steps.parse.added",
          "changed": "$steps.parse.changed",
          "jobs": "$steps.parse.jobs",
          "locator": "$steps.parse.locator",
          "restated": "$steps.parse.restated",
          "retired": "$steps.parse.retired",
          "revised": "$steps.parse.revised",
          "revision": "$steps.parse.revision",
          "scope": "$steps.parse.scope",
          "unparsed": "$steps.parse.unparsed",
          "workflows": "$steps.parse.workflows"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "candidate_templates": {
          "items": "$steps.parse.items"
        },
        "id": "propose",
        "kind": "propose_change_set",
        "result": "$steps.summary"
      },
      {
        "id": "other",
        "kind": "halt",
        "reason": "other_source"
      }
    ],
    "pin_slots": [
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.workflow-facts/v1"
          }
        },
        "slot_name": "parse"
      },
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.repo-snapshot/v2"
          }
        },
        "slot_name": "snapshot"
      }
    ],
    "returns": "summary",
    "terminal_capability": 2
  },
  "definition_digest": "sha256:15b844337225822ec14bb14922f73cc4fdccbd351d3dfa391e2c3753c8cf7a58",
  "identity": {
    "kind": "Procedure",
    "name": "security.repo-parse"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-repo-parse-input"
      },
      "schema": {
        "fields": {
          "forge_host": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "repo_source": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-repo-parse-summary"
      },
      "schema": {
        "fields": {
          "added": {
            "type": "integer"
          },
          "changed": {
            "type": "integer"
          },
          "jobs": {
            "type": "integer"
          },
          "locator": {
            "type": "string"
          },
          "restated": {
            "type": "integer"
          },
          "retired": {
            "type": "integer"
          },
          "revised": {
            "type": "integer"
          },
          "revision": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "unparsed": {
            "type": "json"
          },
          "workflows": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
