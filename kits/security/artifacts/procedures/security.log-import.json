{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 1048576,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 60000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-log-import-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-log-read-summary"
      }
    },
    "description": "Read the log-read Capture that triggered the Line (security.file-erasable-v1) for the Line's incident (parameter incident, its name) and propose the audit by key (incident, service) with its twins and one security.audit.read (SOURCE FROM/TO) for a complete read. An incomplete read is posted (read_incomplete) and never becomes a read: it is a finding about the logs, not about the attacker. Never a result. Halts other_incident for another incident's read. Runs as a Line with trigger_input log.",
    "hard_caps": {
      "max_capture_bytes": 1048576,
      "max_items": 100,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "security.log-import",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.file-erasable-v1"
          }
        },
        "id": "log",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "cruxible-builtin"
          }
        },
        "request": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "security.log-read",
          "relative_path": "log-read.json",
          "replayability": "exact",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        }
      },
      {
        "id": "held",
        "kind": "state_tap",
        "parameters": {
          "incident": "$input.incident"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.audit_status"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "held": "$steps.held.result.rows",
          "incident": "$input.incident",
          "read_text": "$steps.log.content.text",
          "truncated": "$steps.held.truncated"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.log-reads/v1"
          }
        },
        "kind": "call",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "security-analysis-provider/32c7f0af74c944543dd5d06ec7fcceb0610265de1cef3a1e0d32d9b5da9e35fc"
          }
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-log-read-summary"
          }
        },
        "fields": {
          "added": "$steps.parse.added",
          "changed": "$steps.parse.changed",
          "incident": "$steps.parse.incident",
          "matches": "$steps.parse.matches",
          "mine": "$steps.parse.mine",
          "posted": "$steps.parse.posted",
          "read": "$steps.parse.read",
          "recordable": "$steps.parse.recordable",
          "service": "$steps.parse.service",
          "source": "$steps.parse.source"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "mine",
        "kind": "guard",
        "message": "The landed log read is another incident's.",
        "on_false": "other",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "mine"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "other_incident"
      },
      {
        "id": "recordable",
        "kind": "guard",
        "message": "The read is incomplete, or its audit is not stated: posted.",
        "on_false": "post",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "recordable"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "read_not_recordable"
      },
      {
        "id": "changed",
        "kind": "guard",
        "message": "The audit already holds this read.",
        "on_false": "nochange",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "changed"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "no_change"
      },
      {
        "candidate_templates": {
          "items": "$steps.parse.items"
        },
        "id": "propose",
        "kind": "propose_change_set",
        "result": "$steps.summary"
      },
      {
        "id": "post",
        "input": {
          "items": "$steps.parse.inbox"
        },
        "kind": "post_inbox",
        "max_items": 10
      },
      {
        "id": "nochange",
        "kind": "halt",
        "reason": "no_change"
      },
      {
        "id": "other",
        "kind": "halt",
        "reason": "other_incident"
      }
    ],
    "returns": "summary",
    "terminal_capability": 2
  },
  "definition_digest": "sha256:8222043e643b5011b79f0d1dc24b7dd402fd4b7db23bad877b38c53d394ae5b6",
  "identity": {
    "kind": "Procedure",
    "name": "security.log-import"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-log-import-input"
      },
      "schema": {
        "fields": {
          "incident": {
            "type": "string"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-log-read-summary"
      },
      "schema": {
        "fields": {
          "added": {
            "type": "integer"
          },
          "changed": {
            "type": "integer"
          },
          "incident": {
            "type": "string"
          },
          "matches": {
            "type": "integer"
          },
          "mine": {
            "type": "integer"
          },
          "posted": {
            "type": "integer"
          },
          "read": {
            "type": "string"
          },
          "recordable": {
            "type": "integer"
          },
          "service": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  ]
}
