{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security.sarif-attention.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security.sarif-attention.output/v1"
      }
    },
    "description": "Post each regression and location gap in one derived SARIF findings document to the Line's inbox.",
    "hard_caps": {
      "max_capture_bytes": 33554432,
      "max_items": 100000,
      "max_provider_calls": 1,
      "max_read_rows": 20000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.sarif-attention",
    "nodes": [
      {
        "fields": {},
        "id": "summary",
        "kind": "project"
      },
      {
        "captures": {
          "document": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.sarif-findings"
            }
          }
        },
        "id": "findings",
        "input": {
          "held": [],
          "logical_source": "$params.logical_source",
          "logs": [],
          "repo": "$params.repo"
        },
        "kind": "call",
        "slot": "derive"
      },
      {
        "capture": "$steps.findings.document",
        "id": "attention",
        "kind": "extract",
        "records": "attention",
        "row": {
          "digest": "sha256:ab6123ec812fe081ba0c455ba904e0c903efc3f1ebd340707a821de7a9cdf11c",
          "name": "security.sarif-attention-record",
          "version": 1
        }
      },
      {
        "contract": {
          "digest": "sha256:bbf2723cdc63290a0807458e75b4fee3663c80586554bf482d28b39cc94752c4",
          "name": "security.sarif-attention",
          "version": 2
        },
        "dedupe_key": [
          "ref"
        ],
        "fields": {
          "finding": "$item.fields.finding",
          "kind": "$item.fields.kind",
          "locus": "$item.fields.locus",
          "path": "$item.fields.path",
          "reason": "$item.fields.reason",
          "ref": "$item.fields.ref",
          "repo": "$item.fields.repo",
          "rule": "$item.fields.rule",
          "weakness": "$item.fields.weakness"
        },
        "for_each": "$steps.attention.records",
        "id": "post",
        "kind": "post_inbox"
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "security.sarif-attention.params/v1"
      }
    },
    "returns": "summary",
    "slots": {
      "derive": {
        "capability": {
          "digest": "sha256:8b9ead1dac93b805c082e28dd7f59cef36850c69c7404f74a400e2df81f15ab9",
          "name": "security.sarif.findings",
          "version": 1
        }
      }
    },
    "terminal_capability": 1
  },
  "definition_digest": "sha256:71e219f6a577eb221e23441653d5806f02db5e947ea827e9f5038dea95b560ce",
  "identity": {
    "kind": "Procedure",
    "name": "security.sarif-attention"
  }
}
