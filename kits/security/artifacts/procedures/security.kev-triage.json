{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security.kev-triage.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security.kev-triage.output/v1"
      }
    },
    "description": "Read the CISA KEV catalog and write each watched CVE's catalog membership, dates and ransomware use; a complete read records the unlisted ones.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 20000,
      "max_provider_calls": 1,
      "max_read_rows": 50000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.kev-triage",
    "nodes": [
      {
        "captures": {
          "capture": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.kev-catalog"
            }
          }
        },
        "id": "catalog",
        "input": {
          "expected_format": "json",
          "logical_source": "$params.logical_source",
          "max_bytes": "$params.max_bytes",
          "url": "$params.url"
        },
        "kind": "call",
        "slot": "fetch"
      },
      {
        "id": "watched",
        "kind": "read",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.watched_vulnerabilities"
          }
        }
      },
      {
        "capture": "$steps.catalog.capture",
        "complete_when": {
          "count_at": "/count"
        },
        "fields": {
          "date_added": {
            "at": "dateAdded",
            "parse": "date"
          },
          "due_date": {
            "at": "dueDate",
            "parse": "date",
            "presence": "optional"
          },
          "listed_from": {
            "at": "dateAdded",
            "parse": "date",
            "project": "utc_start_of_day"
          },
          "ransomware_use": {
            "at": "knownRansomwareCampaignUse",
            "canonicalize": "claim_type",
            "presence": "optional"
          }
        },
        "header": {
          "catalog_version": {
            "at": "/catalogVersion",
            "presence": "required"
          }
        },
        "id": "entries",
        "key": {
          "cve_id": {
            "at": "cveID",
            "type": "key_part<security.vulnerability:cve_id>"
          }
        },
        "kind": "extract",
        "records": "/vulnerabilities/*",
        "row": {
          "digest": "sha256:4a0615f4aabe5ccc4acc0cbeae98a8712695a59eb3ade3d37faec1770a07dc16",
          "name": "security.kev-record",
          "version": 1
        }
      },
      {
        "claims": [
          {
            "effective_from": "$item.fields.listed_from",
            "rationale": "CISA KEV catalog {$steps.entries.header.catalog_version} lists {$item.key.cve_id}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.listed_in"
              }
            },
            "value": {
              "create": "if_absent",
              "key": {
                "catalog_id": "cisa-kev"
              },
              "kind": "security.catalog"
            },
            "when_absent": "inverse"
          },
          {
            "rationale": "CISA KEV catalog {$steps.entries.header.catalog_version}: dateAdded {$item.fields.date_added}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.kev_date_added"
              }
            },
            "value": "$item.fields.date_added",
            "when_absent": "mirror"
          },
          {
            "rationale": "CISA KEV catalog {$steps.entries.header.catalog_version}: dueDate {$item.fields.due_date}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.kev_due_date"
              }
            },
            "value": "$item.fields.due_date",
            "when_absent": "mirror"
          },
          {
            "rationale": "CISA KEV catalog {$steps.entries.header.catalog_version}: knownRansomwareCampaignUse {$item.fields.ransomware_use}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.vulnerability.kev_ransomware_use"
              }
            },
            "value": "$item.fields.ransomware_use"
          }
        ],
        "expect": "$steps.watched.rows",
        "for_each": "$steps.entries.records",
        "id": "write",
        "kind": "claims",
        "subject": {
          "key": {
            "cve_id": "$item.key.cve_id"
          },
          "kind": "security.vulnerability",
          "within": "$steps.watched.rows"
        }
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "security.kev-triage.params/v1"
      }
    },
    "slots": {
      "fetch": {
        "effect": "external_read",
        "in": {
          "digest": "sha256:1f4eefbeef292080ab075e22d068a4e45f6b01170802f2ca470daa2329444137",
          "name": "web.fetch.request",
          "version": 1
        },
        "out": {
          "digest": "sha256:94f256cdc9f9dfb45d8ac2a55e5aaf40bdb64757cbbf21703baeb8bd8d03062f",
          "name": "web.fetch.result",
          "version": 1
        }
      }
    },
    "terminal_capability": 3
  },
  "definition_digest": "sha256:1390c0c1877e7b15dde052bf1ae929be6b060ee98f5c57e0176f2804c9550a59",
  "identity": {
    "kind": "Procedure",
    "name": "security.kev-triage"
  }
}
