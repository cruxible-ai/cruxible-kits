{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 16777216,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-empty-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-kev-triage-summary"
      }
    },
    "description": "Read the KEV catalog Capture that triggered the Line (security.fetched-v1) and the watched vulnerabilities, and settle one observation Claim per KEV field that changed (kev_listed, kev_date_added, kev_due_date, kev_ransomware_use) under a settle mandate, or propose it under a propose cap. Halts no_change when nothing changed. Runs as a Line with trigger_input catalog.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 5000,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "measurements": [
      {
        "check_after": {
          "microseconds": 259200000000
        },
        "expires_after": {
          "microseconds": 864000000000
        },
        "measurement": {
          "expect": {
            "max_count": 0
          },
          "kind": "accepted_query",
          "query": {
            "artifact_digest": "sha256:2bb6593d47adbe43240fcb12dc0ba27f1032834f209587a0603150baa04249a5",
            "role": "query",
            "target": {
              "kind": "QueryDefinition",
              "name": "security.kev_triage_backlog"
            }
          }
        },
        "name": "kev-backlog-cleared",
        "review_when": [
          {
            "metric": "satisfied_rate",
            "min_readings": 5,
            "name": "satisfied-rate-low",
            "operator": "lt",
            "threshold": {
              "$decimal": "0.8"
            }
          }
        ],
        "subject_grain": "procedure_unit"
      }
    ],
    "name": "security.kev-triage",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.fetched-v1"
          }
        },
        "id": "catalog",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "web.fetch/v3"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "cruxible-provider-web/ddc99c153ce3ca4226d991f11ab40f1d96fa0ad4364c8918f8aa82b0c840218b"
          }
        },
        "request": {
          "expected_format": "json",
          "extract": false,
          "logical_source": "cisa.kev.catalog",
          "max_bytes": 4194304,
          "render": false,
          "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
        }
      },
      {
        "id": "watched",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.watched_vulnerabilities"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "catalog_base64": "$steps.catalog.retrieved.body_base64",
          "watched": "$steps.watched.result.rows"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.kev-catalog/v2"
          }
        },
        "kind": "call",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "security-analysis-provider/32c7f0af74c944543dd5d06ec7fcceb0610265de1cef3a1e0d32d9b5da9e35fc"
          }
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-kev-triage-summary"
          }
        },
        "fields": {
          "catalog_version": "$steps.parse.catalog_version",
          "changed": "$steps.parse.changed",
          "listed": "$steps.parse.listed",
          "watched": "$steps.parse.watched"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "changed",
        "kind": "guard",
        "message": "The catalog changes no watched Claim.",
        "on_false": "nochange",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "changed"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "no_change"
      },
      {
        "candidate_templates": {
          "items": "$steps.parse.items"
        },
        "id": "settle",
        "kind": "settle_change_set",
        "result": "$steps.summary"
      },
      {
        "id": "nochange",
        "kind": "halt",
        "reason": "no_change"
      }
    ],
    "returns": "summary",
    "terminal_capability": 3
  },
  "definition_digest": "sha256:e4a4749162210ccb2272807880101e73397662d3b415c0c36a52733565340d9e",
  "identity": {
    "kind": "Procedure",
    "name": "security.kev-triage"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-empty-input"
      },
      "schema": {
        "fields": {}
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-kev-triage-summary"
      },
      "schema": {
        "fields": {
          "catalog_version": {
            "type": "string"
          },
          "changed": {
            "type": "integer"
          },
          "listed": {
            "type": "integer"
          },
          "watched": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
