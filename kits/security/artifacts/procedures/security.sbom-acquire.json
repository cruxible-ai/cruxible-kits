{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 1048576,
      "max_provider_calls": 1,
      "wall_clock": {
        "microseconds": 60000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-path-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-file-evidence"
      }
    },
    "description": "Read one CycloneDX JSON SBOM from the attached workspace (input.relative_path) and retain it under security.file-v1; security.sbom-import reads it when it lands. At most 1 MiB (the built-in workspace.file's limit).",
    "hard_caps": {
      "max_capture_bytes": 1048576,
      "max_items": 1,
      "max_provider_calls": 1,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "security.sbom-acquire",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.file-v1"
          }
        },
        "id": "sbom",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "cruxible-builtin"
          }
        },
        "request": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "cyclonedx.sbom",
          "relative_path": "$input.relative_path",
          "replayability": "exact",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-file-evidence"
          }
        },
        "fields": {
          "byte_length": "$steps.sbom.source.byte_length",
          "bytes_digest": "$steps.sbom.source.bytes_digest"
        },
        "id": "summary",
        "kind": "project"
      }
    ],
    "returns": "summary",
    "terminal_capability": 1
  },
  "definition_digest": "sha256:f128141c72757e8e602ef93f09160f80f763fbebabbc0f4e40385b4755d28acf",
  "identity": {
    "kind": "Procedure",
    "name": "security.sbom-acquire"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-file-evidence"
      },
      "schema": {
        "fields": {
          "byte_length": {
            "type": "integer"
          },
          "bytes_digest": {
            "type": "string"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-path-input"
      },
      "schema": {
        "fields": {
          "relative_path": {
            "type": "string"
          }
        }
      }
    }
  ]
}
