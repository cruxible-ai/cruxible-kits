{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 1048576,
      "max_provider_calls": 1,
      "wall_clock": {
        "microseconds": 60000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-path-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-file-evidence"
      }
    },
    "description": "Read one log read from the attached workspace (input.relative_path, at most 1 MiB): {audit: {incident, service}, source, query, from, to, complete, records_scanned, matches: [{at, summary}]}, written by the agent from its own log tool's answer, match summaries redacted. Retained under security.file-erasable-v1; the incident's security.log-import Line reads it when it lands. complete means every record in [from, to] was searched: no sampling, no result cap, retention reaching from.",
    "hard_caps": {
      "max_capture_bytes": 1048576,
      "max_items": 1,
      "max_provider_calls": 1,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "security.log-acquire",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.file-erasable-v1"
          }
        },
        "id": "log",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "cruxible-builtin"
          }
        },
        "request": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "security.log-read",
          "relative_path": "$input.relative_path",
          "replayability": "exact",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-file-evidence"
          }
        },
        "fields": {
          "byte_length": "$steps.log.source.byte_length",
          "bytes_digest": "$steps.log.source.bytes_digest"
        },
        "id": "summary",
        "kind": "project"
      }
    ],
    "returns": "summary",
    "terminal_capability": 1
  },
  "definition_digest": "sha256:d46678f3a20a51750661a99b08088632624509c1bf2bae1c8b2c61cdcd127bb4",
  "identity": {
    "kind": "Procedure",
    "name": "security.log-acquire"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-file-evidence"
      },
      "schema": {
        "fields": {
          "byte_length": {
            "type": "integer"
          },
          "bytes_digest": {
            "type": "string"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-path-input"
      },
      "schema": {
        "fields": {
          "relative_path": {
            "type": "string"
          }
        }
      }
    }
  ]
}
