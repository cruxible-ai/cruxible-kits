{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 1048576,
      "max_provider_calls": 1,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-respond-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-respond-summary"
      }
    },
    "description": "Ask one incident's five questions (parameter incident, its name) and answer each in three states: found (posted), none (run summary only) or unknown (posted as a gap naming the pull or statement that would answer it). RQ1 which deployments run an affected release: every asset (security.deployments) and every release a scan observed on one or it declares, for each incident CVE. A deployment's none needs a current full scan of the asset that looked for the product, and the release's none: its assessment (a negative that rests on components holds while they are the release's), or OSV's answer for every component of the exact current set with none a package OSV says the CVE affects (citing those Claims). Else unknown naming the next step (the inventory pull for a missing, stale or erased scan, or products a scan didn't look for; the CVE record pull; the purl types OSV does not index; the OSV Line; an analyst's judgment last): never silent. More than 200 items to post refuses (overflow) rather than cut the rest; RQ2 is each exposure patched (missing, overdue, disputed; none only when a full scan verified it; excepted while an approved exception for each of its CVEs has not expired, then missing again); RQ3 were we exploited in the window, per service (none only for not_exploited with complete reads of every stated log source covering the window); RQ4 which credentials warrant rotation (posted with the audit and patch state; rotating after a verified patch is the recommended order, the agent's call), and is each rotation verified by a separate state read; RQ5 can the incident close (ready_to_close, with any unknown audit as accepted residue). A closed incident posts nothing. Observe-only. Runs as a Line (parameters incident, inventory_pull, log_pull, credential_pull, record_pull, optional osv_line): daily, on a landing, after a window closes, or line run.",
    "hard_caps": {
      "max_capture_bytes": 1048576,
      "max_items": 200,
      "max_provider_calls": 1,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.respond",
    "nodes": [
      {
        "id": "exposure",
        "kind": "state_tap",
        "parameters": {
          "incident": "$input.incident"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.incident_exposure"
          }
        }
      },
      {
        "id": "hosts",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.scanned_runs"
          }
        }
      },
      {
        "id": "deployments",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.deployments"
          }
        }
      },
      {
        "id": "patches",
        "kind": "state_tap",
        "parameters": {
          "incident": "$input.incident"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.incident_patches"
          }
        }
      },
      {
        "id": "overdue",
        "kind": "state_tap",
        "parameters": {
          "incident": "$input.incident"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.overdue_patches"
          }
        }
      },
      {
        "id": "exceptions",
        "kind": "state_tap",
        "parameters": {
          "incident": "$input.incident"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.incident_exceptions"
          }
        }
      },
      {
        "id": "audits",
        "kind": "state_tap",
        "parameters": {
          "incident": "$input.incident"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.audit_status"
          }
        }
      },
      {
        "id": "credentials",
        "kind": "state_tap",
        "parameters": {
          "incident": "$input.incident"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.incident_credentials"
          }
        }
      },
      {
        "id": "classify",
        "input": {
          "audits": "$steps.audits.result.rows",
          "credentials": "$steps.credentials.result.rows",
          "deployments": "$steps.deployments.result.rows",
          "exceptions": "$steps.exceptions.result.rows",
          "exposure": "$steps.exposure.result.rows",
          "hosts": "$steps.hosts.result.rows",
          "overdue": "$steps.overdue.result.rows",
          "params": "$input",
          "patches": "$steps.patches.result.rows",
          "truncated": {
            "audits": "$steps.audits.truncated",
            "credentials": "$steps.credentials.truncated",
            "deployments": "$steps.deployments.truncated",
            "exceptions": "$steps.exceptions.truncated",
            "exposure": "$steps.exposure.truncated",
            "hosts": "$steps.hosts.truncated",
            "overdue": "$steps.overdue.truncated",
            "patches": "$steps.patches.truncated"
          }
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.respond/v1"
          }
        },
        "kind": "call",
        "provider": {
          "slot_name": "classify"
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-respond-summary"
          }
        },
        "fields": {
          "answers": "$steps.classify.answers",
          "found": "$steps.classify.found",
          "incident": "$steps.classify.incident",
          "none": "$steps.classify.none",
          "posted": "$steps.classify.posted",
          "ready_to_close": "$steps.classify.ready_to_close",
          "status": "$steps.classify.status",
          "unknown": "$steps.classify.unknown"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "posted",
        "kind": "guard",
        "message": "Nothing to post: no question is found or unknown (every answer rests on evidence of none), or the incident is closed.",
        "on_false": "quiet",
        "predicate": {
          "left": {
            "alias": "classify",
            "kind": "step",
            "path": [
              "posted"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "nothing_to_post"
      },
      {
        "id": "post",
        "input": {
          "items": "$steps.classify.items"
        },
        "kind": "post_inbox",
        "max_items": 200
      },
      {
        "id": "quiet",
        "kind": "halt",
        "reason": "nothing_to_post"
      }
    ],
    "pin_slots": [
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.respond/v1"
          }
        },
        "slot_name": "classify"
      }
    ],
    "returns": "summary",
    "terminal_capability": 1
  },
  "definition_digest": "sha256:15d19595100801260da189ae34bbe502ab7414bbc0736613e995fa1e83d2c7c7",
  "identity": {
    "kind": "Procedure",
    "name": "security.respond"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-respond-input"
      },
      "schema": {
        "fields": {
          "credential_pull": {
            "type": "string"
          },
          "incident": {
            "type": "string"
          },
          "inventory_pull": {
            "type": "string"
          },
          "log_pull": {
            "type": "string"
          },
          "osv_line": {
            "optional": true,
            "type": "string"
          },
          "record_pull": {
            "type": "string"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-respond-summary"
      },
      "schema": {
        "fields": {
          "answers": {
            "type": "json"
          },
          "found": {
            "type": "integer"
          },
          "incident": {
            "type": "string"
          },
          "none": {
            "type": "integer"
          },
          "posted": {
            "type": "integer"
          },
          "ready_to_close": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "unknown": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
