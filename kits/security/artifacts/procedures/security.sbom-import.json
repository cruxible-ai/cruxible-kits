{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 16777216,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-empty-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-sbom-summary"
      }
    },
    "description": "Read the CycloneDX SBOM Capture that triggered the Line (security.file-v1) and propose its product and release (created by key, or the held ones), the release's product link, supplier, and one security.release.component observation per component purl the release does not hold yet. Propose-only. Runs as a Line with trigger_input sbom.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 5000,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.sbom-import",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.file-v1"
          }
        },
        "id": "sbom",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "kind": "source",
        "provider": {
          "slot_name": "sbom"
        },
        "request": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "cyclonedx.sbom",
          "relative_path": "sbom.cdx.json",
          "replayability": "exact",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        }
      },
      {
        "id": "releases",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.release_inventory"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "osv_ecosystems": {
            "apk/alpine": "Alpine",
            "apk/chainguard": "Chainguard",
            "apk/wolfi": "Wolfi",
            "bitnami": "Bitnami",
            "cargo": "crates.io",
            "composer": "Packagist",
            "conan": "ConanCenter",
            "cran": "CRAN",
            "deb/debian": "Debian",
            "deb/ubuntu": "Ubuntu",
            "gem": "RubyGems",
            "githubactions": "GitHub Actions",
            "golang": "Go",
            "hackage": "Hackage",
            "hex": "Hex",
            "maven": "Maven",
            "npm": "npm",
            "nuget": "NuGet",
            "pub": "Pub",
            "pypi": "PyPI",
            "rpm/almalinux": "AlmaLinux",
            "rpm/mageia": "Mageia",
            "rpm/openeuler": "openEuler",
            "rpm/opensuse": "openSUSE",
            "rpm/redhat": "Red Hat",
            "rpm/rocky-linux": "Rocky Linux",
            "rpm/suse": "SUSE",
            "swift": "SwiftURL"
          },
          "releases": "$steps.releases.result.rows",
          "sbom_text": "$steps.sbom.content.text"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.cyclonedx-components/v1"
          }
        },
        "kind": "call",
        "provider": {
          "slot_name": "parse"
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-sbom-summary"
          }
        },
        "fields": {
          "added": "$steps.parse.added",
          "changed": "$steps.parse.changed",
          "components": "$steps.parse.components",
          "osv_not_indexed": "$steps.parse.osv_not_indexed",
          "osv_unindexed": "$steps.parse.osv_unindexed",
          "product": "$steps.parse.product",
          "skipped": "$steps.parse.skipped",
          "version": "$steps.parse.version"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "changed",
        "kind": "guard",
        "message": "The SBOM adds nothing inventory lacks.",
        "on_false": "nochange",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "changed"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "no_change"
      },
      {
        "candidate_templates": {
          "items": "$steps.parse.items"
        },
        "id": "propose",
        "kind": "propose_change_set",
        "result": "$steps.summary"
      },
      {
        "id": "nochange",
        "kind": "halt",
        "reason": "no_change"
      }
    ],
    "pin_slots": [
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.cyclonedx-components/v1"
          }
        },
        "slot_name": "parse"
      },
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "slot_name": "sbom"
      }
    ],
    "returns": "summary",
    "terminal_capability": 2
  },
  "definition_digest": "sha256:412a88224513ddacf4365db20d37cc3491310c75c12746027bbc113a067fa8af",
  "identity": {
    "kind": "Procedure",
    "name": "security.sbom-import"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-empty-input"
      },
      "schema": {
        "fields": {}
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-sbom-summary"
      },
      "schema": {
        "fields": {
          "added": {
            "type": "integer"
          },
          "changed": {
            "type": "integer"
          },
          "components": {
            "type": "integer"
          },
          "osv_not_indexed": {
            "type": "json"
          },
          "osv_unindexed": {
            "type": "integer"
          },
          "product": {
            "type": "string"
          },
          "skipped": {
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  ]
}
