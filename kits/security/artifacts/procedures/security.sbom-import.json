{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security.sbom-import.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security.sbom-import.output/v1"
      }
    },
    "description": "Read one CycloneDX or SPDX 2.x JSON SBOM from the workspace and write each component's occurrence in the inventory it describes, with its scope (and, for a distro package, the OSV source package it is asked as); a component the SBOM no longer lists has its scope retired.",
    "hard_caps": {
      "max_capture_bytes": 8388608,
      "max_items": 40000,
      "max_provider_calls": 2,
      "max_read_rows": 20000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "security.sbom-import",
    "nodes": [
      {
        "captures": {
          "capture": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.cyclonedx-sbom"
            }
          }
        },
        "id": "sbom",
        "input": {
          "logical_source": "$params.logical_source",
          "relative_path": "$params.relative_path"
        },
        "kind": "call",
        "slot": "read"
      },
      {
        "captures": {
          "document": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.sbom-components"
            }
          }
        },
        "id": "derived",
        "input": {
          "logical_source": "$params.logical_source",
          "relative_path": "$params.relative_path",
          "sbom": "$steps.sbom.capture"
        },
        "kind": "call",
        "slot": "derive"
      },
      {
        "capture": "$steps.derived.document",
        "header": [
          "inventory"
        ],
        "id": "listed",
        "kind": "extract",
        "records": "components",
        "row": {
          "digest": "sha256:6002ca8933120edb73444582d49d7ae779354cfe4f5c914fb573238ccbb3c07e",
          "name": "security.sbom-component",
          "version": 2
        }
      },
      {
        "claims": [
          {
            "rationale": "The SBOM at {$params.relative_path} lists {$item.key.purl} with scope {$item.fields.scope} (inventory {$steps.listed.header.inventory}, named by {$item.fields.named_by}).",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.occurrence.scope"
              }
            },
            "value": "$item.fields.scope",
            "when_absent": "mirror"
          },
          {
            "rationale": "The SBOM at {$params.relative_path} states the source package OSV is asked by for {$item.key.purl}.",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.occurrence.osv_package"
              }
            },
            "value": "$item.fields.osv_package",
            "when_absent": "mirror"
          }
        ],
        "expect": {
          "by": "inventory",
          "ends": [
            "$steps.listed.header.inventory"
          ]
        },
        "for_each": "$steps.listed.records",
        "id": "write",
        "kind": "claims",
        "subject": {
          "create": "if_absent",
          "key": {
            "component": {
              "create": "if_absent",
              "key": {
                "purl": "$item.key.purl"
              },
              "kind": "security.component"
            },
            "inventory": {
              "create": "if_absent",
              "key": {
                "inventory_id": "$steps.listed.header.inventory"
              },
              "kind": "security.inventory"
            }
          },
          "kind": "security.occurrence"
        }
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "security.sbom-import.params/v3"
      }
    },
    "slots": {
      "derive": {
        "capability": {
          "digest": "sha256:8ba61aa6486cb5584135d6498c30940346d9dfef225202d2499e289314b90820",
          "name": "security.sbom.components",
          "version": 1
        }
      },
      "read": {
        "capability": {
          "digest": "sha256:bf3721f916492c908d0db48103a457caad6b2f58c6ad0babc92470a0fdccea5e",
          "name": "workspace.file",
          "version": 1
        }
      }
    },
    "terminal_capability": 3
  },
  "definition_digest": "sha256:b29f21812e763d17a167d4ee313e9fee100bbb96773da40c6b75bad86dad3d14",
  "identity": {
    "kind": "Procedure",
    "name": "security.sbom-import"
  }
}
