{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security.sbom-import.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security.sbom-import.output/v1"
      }
    },
    "description": "Read one CycloneDX JSON SBOM from the workspace and write each component's occurrence in the inventory it describes, with its scope; a component the SBOM no longer lists has its scope retired.",
    "hard_caps": {
      "max_capture_bytes": 8388608,
      "max_items": 40000,
      "max_provider_calls": 2,
      "max_read_rows": 20000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "security.sbom-import",
    "nodes": [
      {
        "captures": {
          "capture": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.cyclonedx-sbom"
            }
          }
        },
        "id": "sbom",
        "input": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "$params.logical_source",
          "relative_path": "$params.relative_path",
          "replayability": "attested_only",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        },
        "kind": "call",
        "slot": "read"
      },
      {
        "captures": {
          "document": {
            "target": {
              "kind": "CaptureContract",
              "name": "security.sbom-components"
            }
          }
        },
        "id": "derived",
        "input": {
          "logical_source": "$params.logical_source",
          "relative_path": "$params.relative_path",
          "sbom": "$steps.sbom.capture"
        },
        "kind": "call",
        "slot": "derive"
      },
      {
        "capture": "$steps.derived.document",
        "complete_when": {
          "count_at": "/count"
        },
        "fields": {
          "name": {
            "at": "name",
            "presence": "optional"
          },
          "named_by": {
            "at": "named_by"
          },
          "scope": {
            "at": "scope",
            "canonicalize": "claim_type"
          },
          "warning": {
            "at": "warning",
            "presence": "optional"
          }
        },
        "header": {
          "inventory": {
            "at": "/inventory",
            "type": "string{min_len: 1, max_len: 256}"
          }
        },
        "id": "listed",
        "key": {
          "purl": {
            "at": "purl",
            "type": "key_part<security.component:purl>"
          }
        },
        "kind": "extract",
        "records": "/components/*",
        "row": {
          "digest": "sha256:f8b48814c88ac2cdeadc62e9c4f9c65ee0e8b62ccbd118a3af5cfa1ea2076532",
          "name": "security.sbom-component",
          "version": 1
        }
      },
      {
        "claims": [
          {
            "rationale": "The SBOM at {$params.relative_path} lists {$item.key.purl} with scope {$item.fields.scope} (inventory {$steps.listed.header.inventory}, named by {$item.fields.named_by}).",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "security.occurrence.scope"
              }
            },
            "value": "$item.fields.scope",
            "when_absent": "mirror"
          }
        ],
        "expect": {
          "by": "inventory",
          "ends": [
            "$steps.listed.header.inventory"
          ]
        },
        "for_each": "$steps.listed.records",
        "id": "write",
        "kind": "claims",
        "subject": {
          "create": "if_absent",
          "key": {
            "component": {
              "create": "if_absent",
              "key": {
                "purl": "$item.key.purl"
              },
              "kind": "security.component"
            },
            "inventory": {
              "create": "if_absent",
              "key": {
                "inventory_id": "$steps.listed.header.inventory"
              },
              "kind": "security.inventory"
            }
          },
          "kind": "security.occurrence"
        }
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "security.sbom-import.params/v1"
      }
    },
    "slots": {
      "derive": {
        "effect": "pure",
        "in": {
          "digest": "sha256:5c622fc01dfabd8c7bd71842eeddb10d54255951a2105bab3ca28160fb5811ba",
          "name": "sbom.components.request",
          "version": 1
        },
        "out": {
          "digest": "sha256:4fa2f7cb4d5f000a30abe573f4026c570558d84a3831410417331b5e7ddc6c60",
          "name": "sbom.components.result",
          "version": 1
        }
      },
      "read": {
        "effect": "pure",
        "in": {
          "digest": "sha256:d9c33d4ac151700c89f5391b66adf73c6e6cddfc199670cd4cb9dc01651f7240",
          "name": "workspace.file.request",
          "version": 1
        },
        "out": {
          "digest": "sha256:fe3980a054beed0610045a28a27fbb50c0bad89e91fb5059a76667e34e169dd8",
          "name": "workspace.file.result",
          "version": 1
        }
      }
    },
    "terminal_capability": 3
  },
  "definition_digest": "sha256:67d3b50cf7bf0bcd14245975e9e14fabb2edd5590384bdd0239d03f500e0c8c0",
  "identity": {
    "kind": "Procedure",
    "name": "security.sbom-import"
  }
}
