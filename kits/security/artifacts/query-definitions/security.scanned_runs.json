{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "Every release a scan observed running on an asset an inventory scope's scan read, with the release's components and OSV coverage: the respond Line answers each incident CVE x each of these releases (none only when OSV answered every component and none is a package OSV says the CVE affects). Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "release",
    "subject_kinds": [
      "security.release"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.scanned_runs"
  },
  "includes": [
    {
      "binding": "included_component",
      "direction": "forward",
      "from_binding": "release",
      "many": true,
      "max_items": 500,
      "name": "component",
      "predicate": "security.release.component"
    }
  ],
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "components",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.component"
        }
      },
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage_revision",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "hostname",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "looked_for",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.looked_for"
        }
      },
      {
        "name": "osv_coverage",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.osv_coverage"
        }
      },
      {
        "name": "product_name",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "unidentified",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.unidentified_components"
        }
      },
      {
        "name": "version",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "asset",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.asset.runs",
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "coverage",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.scanned_in",
      "target_subject_kinds": [
        "security.coverage"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "inventory.runtime"
        },
        "value_type": "string"
      }
    }
  ]
}
