{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "HQ5: every artifact a gated target serves, its served and declared digests, and the workflow and jobs that published it at the commit it was built from. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "target",
    "subject_kinds": [
      "security.target"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.served_vs_declared"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "artifact",
        "value": {
          "binding": "artifact",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "artifact_name",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.name"
        }
      },
      {
        "name": "declared_sha256",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.declared_sha256"
        }
      },
      {
        "name": "gate",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.publish_gate"
        }
      },
      {
        "name": "job",
        "value": {
          "binding": "job",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "job_environment",
        "value": {
          "binding": "job",
          "kind": "claim_value",
          "predicate": "security.job.environment"
        }
      },
      {
        "name": "job_key",
        "value": {
          "binding": "job",
          "kind": "claim_value",
          "predicate": "security.job.job_key"
        }
      },
      {
        "name": "job_publishes",
        "value": {
          "binding": "job",
          "kind": "claim_value",
          "predicate": "security.job.publishes_to"
        }
      },
      {
        "name": "publish_environment",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.publish_environment"
        }
      },
      {
        "name": "registry_coverage",
        "value": {
          "binding": "registry_coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "registry_coverage_revision",
        "value": {
          "binding": "registry_coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "registry_coverage_source",
        "value": {
          "binding": "registry_coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.source"
        }
      },
      {
        "name": "repo",
        "value": {
          "binding": "repo",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "repo_host",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.forge_host"
        }
      },
      {
        "name": "repo_name",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.full_name"
        }
      },
      {
        "name": "sha256",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.sha256"
        }
      },
      {
        "name": "target",
        "value": {
          "binding": "target",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "target_name",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.name"
        }
      },
      {
        "name": "target_registry",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.registry"
        }
      },
      {
        "name": "workflow",
        "value": {
          "binding": "workflow",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "workflow_coverage",
        "value": {
          "binding": "workflow_coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "workflow_coverage_revision",
        "value": {
          "binding": "workflow_coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "workflow_coverage_source",
        "value": {
          "binding": "workflow_coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.source"
        }
      },
      {
        "name": "workflow_path",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.path"
        }
      },
      {
        "name": "workflow_source",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.source"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "repo",
      "direction": "forward",
      "from_binding": "target",
      "predicate": "security.target.source_repo",
      "required": false,
      "target_subject_kinds": [
        "security.repo"
      ]
    },
    {
      "binding": "registry_coverage",
      "direction": "reverse",
      "from_binding": "target",
      "predicate": "security.coverage.of",
      "required": false,
      "target_subject_kinds": [
        "security.coverage"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "registry_coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "registry.files"
        },
        "value_type": "string"
      }
    },
    {
      "binding": "artifact",
      "direction": "reverse",
      "from_binding": "target",
      "predicate": "security.artifact.target",
      "required": false,
      "target_subject_kinds": [
        "security.artifact"
      ]
    },
    {
      "binding": "workflow",
      "direction": "forward",
      "from_binding": "artifact",
      "predicate": "security.artifact.published_by",
      "required": false,
      "target_subject_kinds": [
        "security.workflow"
      ]
    },
    {
      "binding": "workflow_coverage",
      "direction": "forward",
      "from_binding": "workflow",
      "predicate": "security.workflow.coverage",
      "required": false,
      "target_subject_kinds": [
        "security.coverage"
      ]
    },
    {
      "binding": "job",
      "direction": "reverse",
      "from_binding": "workflow",
      "predicate": "security.job.workflow",
      "required": false,
      "target_subject_kinds": [
        "security.job"
      ]
    }
  ],
  "where": {
    "binding": "target",
    "kind": "claim_presence",
    "predicate": "security.target.publish_gate"
  }
}
