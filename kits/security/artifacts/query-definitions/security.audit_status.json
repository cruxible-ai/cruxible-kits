{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "description": "RQ3 for one incident: every audit (one per service) with its log sources and the service's (service_log_source), complete reads, window end and result (conflict while disputed); the respond Line unions the reads per source against the window. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "incident",
    "subject_kinds": [
      "security.incident"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.audit_status"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "incident",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "audit",
        "value": {
          "binding": "audit",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "incident",
        "value": {
          "binding": "incident",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "incident_status",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.status"
        }
      },
      {
        "name": "log_source",
        "value": {
          "binding": "audit",
          "kind": "claim_value",
          "predicate": "security.audit.log_source"
        }
      },
      {
        "name": "read",
        "value": {
          "binding": "audit",
          "kind": "claim_value",
          "predicate": "security.audit.read"
        }
      },
      {
        "name": "result",
        "value": {
          "binding": "audit",
          "kind": "claim_value",
          "predicate": "security.audit.result"
        }
      },
      {
        "name": "rotation_policy",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.rotation_policy"
        }
      },
      {
        "name": "service",
        "value": {
          "binding": "service",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "service_log_source",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.log_source"
        }
      },
      {
        "name": "service_name",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.name"
        }
      },
      {
        "name": "service_ref",
        "value": {
          "binding": "audit",
          "kind": "claim_value",
          "predicate": "security.audit.service_ref"
        }
      },
      {
        "name": "window_end",
        "value": {
          "binding": "audit",
          "kind": "claim_value",
          "predicate": "security.audit.window_end"
        }
      },
      {
        "name": "window_start",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.window_start"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "audit",
      "direction": "reverse",
      "from_binding": "incident",
      "predicate": "security.audit.incident",
      "target_subject_kinds": [
        "security.audit"
      ]
    },
    {
      "binding": "service",
      "direction": "forward",
      "from_binding": "audit",
      "predicate": "security.audit.service",
      "required": false,
      "target_subject_kinds": [
        "security.service"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "incident",
      "kind": "claim_value",
      "predicate": "security.incident.name"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "incident"
    },
    "value_type": "string"
  }
}
