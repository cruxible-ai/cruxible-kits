{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "One inventory scope's coverage (source = the scope's name, stale or current) with every asset scanned in it, its runs and its nones (asset.runs inverses: a product the asset runs none of) and the products of the releases it declares installing, with the Claims behind them: the runtime-inventory import's tap. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "coverage",
    "subject_kinds": [
      "security.coverage"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current",
      "stale"
    ],
    "visible_verdicts": [
      "stale",
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.inventory_index"
  },
  "includes": [
    {
      "binding": "included_looked_for",
      "direction": "forward",
      "from_binding": "coverage",
      "many": true,
      "max_items": 500,
      "name": "looked_for",
      "predicate": "security.coverage.looked_for"
    },
    {
      "binding": "included_runs",
      "direction": "forward",
      "from_binding": "asset",
      "many": true,
      "max_items": 500,
      "name": "runs",
      "predicate": "security.asset.runs"
    },
    {
      "binding": "included_scanned_in",
      "direction": "forward",
      "from_binding": "asset",
      "many": true,
      "max_items": 500,
      "name": "scanned_in",
      "predicate": "security.asset.scanned_in"
    }
  ],
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "scope",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "declared_product",
        "value": {
          "binding": "declared",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "hostname",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "looked_for",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.looked_for"
        }
      },
      {
        "name": "revision",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "source",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.source"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "asset",
      "direction": "reverse",
      "from_binding": "coverage",
      "predicate": "security.asset.scanned_in",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "declared",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.installs",
      "required": false,
      "target_subject_kinds": [
        "security.release"
      ]
    }
  ],
  "where": {
    "filters": [
      {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "inventory.runtime"
        },
        "value_type": "string"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.source"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "scope"
        },
        "value_type": "string"
      }
    ],
    "kind": "all_of"
  }
}
