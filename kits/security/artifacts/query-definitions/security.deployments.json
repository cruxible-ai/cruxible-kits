{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "Every asset, with its inventory coverage (revision and looked_for: stale, missing or erased reads absent), its current nones (include runs: asset.runs inverses) and every release it declares installing (components, OSV coverage): the respond Line enumerates deployments from it, never through assessments, so an unscanned or unassessed deployment is a gap, never silence. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "asset",
    "subject_kinds": [
      "security.asset"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.deployments"
  },
  "includes": [
    {
      "binding": "included_declared_component",
      "direction": "forward",
      "from_binding": "declared",
      "many": true,
      "max_items": 500,
      "name": "declared_component",
      "predicate": "security.release.component"
    },
    {
      "binding": "included_runs",
      "direction": "forward",
      "from_binding": "asset",
      "many": true,
      "max_items": 500,
      "name": "runs",
      "predicate": "security.asset.runs"
    }
  ],
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage_revision",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "declared",
        "value": {
          "binding": "declared",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "declared_components",
        "value": {
          "binding": "declared",
          "kind": "claim_value",
          "predicate": "security.release.component"
        }
      },
      {
        "name": "declared_osv_coverage",
        "value": {
          "binding": "declared",
          "kind": "claim_value",
          "predicate": "security.release.osv_coverage"
        }
      },
      {
        "name": "declared_product_name",
        "value": {
          "binding": "declared",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "declared_unidentified",
        "value": {
          "binding": "declared",
          "kind": "claim_value",
          "predicate": "security.release.unidentified_components"
        }
      },
      {
        "name": "declared_version",
        "value": {
          "binding": "declared",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "hostname",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "looked_for",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.looked_for"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "coverage",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.scanned_in",
      "required": false,
      "target_subject_kinds": [
        "security.coverage"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "inventory.runtime"
        },
        "value_type": "string"
      }
    },
    {
      "binding": "declared",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.installs",
      "required": false,
      "target_subject_kinds": [
        "security.release"
      ]
    }
  ]
}
