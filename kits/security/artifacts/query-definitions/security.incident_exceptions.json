{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "RQ2's accepted risks for one incident: every approved exception (work.asset + work.assessment) of an asset for one of its CVEs that has not expired at the query's evaluation time, with its expiry, owner and rationale: the respond Line's exception tap. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "incident",
    "subject_kinds": [
      "security.incident"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.incident_exceptions"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "incident",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "assessment",
        "value": {
          "binding": "assessment",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "cve_id",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.cve_id"
        }
      },
      {
        "name": "exception",
        "value": {
          "binding": "exception",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "expires_at",
        "value": {
          "binding": "exception",
          "kind": "claim_value",
          "predicate": "security.exception.expires_at"
        }
      },
      {
        "name": "hostname",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "incident",
        "value": {
          "binding": "incident",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "incident_status",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.status"
        }
      },
      {
        "name": "owner",
        "value": {
          "binding": "owner",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "product_name",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "rationale",
        "value": {
          "binding": "exception",
          "kind": "claim_value",
          "predicate": "security.work.rationale"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "rotation_policy",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.rotation_policy"
        }
      },
      {
        "name": "status",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "status_role",
        "value": {
          "binding": "assessment",
          "field": "role",
          "kind": "claim_field",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "version",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "window_start",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.window_start"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "vulnerability",
      "direction": "forward",
      "from_binding": "incident",
      "predicate": "security.incident.vulnerability",
      "target_subject_kinds": [
        "security.vulnerability"
      ]
    },
    {
      "binding": "assessment",
      "direction": "reverse",
      "from_binding": "vulnerability",
      "predicate": "security.assessment.vulnerability",
      "target_subject_kinds": [
        "security.assessment"
      ],
      "where": {
        "filters": [
          {
            "kind": "comparison",
            "left": {
              "binding": "assessment",
              "kind": "claim_value",
              "predicate": "security.assessment.status"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "affected"
            },
            "value_type": "string"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "assessment",
              "kind": "claim_value",
              "predicate": "security.assessment.status"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "inconclusive"
            },
            "value_type": "string"
          }
        ],
        "kind": "any_of"
      }
    },
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.release",
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "exception",
      "direction": "reverse",
      "from_binding": "assessment",
      "predicate": "security.work.assessment",
      "target_subject_kinds": [
        "security.exception"
      ],
      "where": {
        "filters": [
          {
            "kind": "comparison",
            "left": {
              "binding": "exception",
              "kind": "claim_value",
              "predicate": "security.exception.approval"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "approved"
            },
            "value_type": "string"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "exception",
              "kind": "claim_value",
              "predicate": "security.exception.expires_at"
            },
            "operator": "gt",
            "right": {
              "kind": "evaluation_time"
            },
            "value_type": "timestamp"
          }
        ],
        "kind": "all_of"
      }
    },
    {
      "binding": "asset",
      "direction": "forward",
      "from_binding": "exception",
      "predicate": "security.work.asset",
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "owner",
      "direction": "forward",
      "from_binding": "exception",
      "predicate": "security.work.owner",
      "required": false,
      "target_subject_kinds": [
        "security.team"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "incident",
      "kind": "claim_value",
      "predicate": "security.incident.name"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "incident"
    },
    "value_type": "string"
  }
}
