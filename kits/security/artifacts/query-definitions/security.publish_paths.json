{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "HQ1: every job that can publish to a gated target, with its workflow's triggers, beside the coverage of the target's repository. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "target",
    "subject_kinds": [
      "security.target"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.publish_paths"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage_revision",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "coverage_source",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.source"
        }
      },
      {
        "name": "gate",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.publish_gate"
        }
      },
      {
        "name": "job",
        "value": {
          "binding": "job",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "job_coverage",
        "value": {
          "binding": "job_coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "job_key",
        "value": {
          "binding": "job",
          "kind": "claim_value",
          "predicate": "security.job.job_key"
        }
      },
      {
        "name": "repo",
        "value": {
          "binding": "repo",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "repo_host",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.forge_host"
        }
      },
      {
        "name": "repo_name",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.full_name"
        }
      },
      {
        "name": "target",
        "value": {
          "binding": "target",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "target_name",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.name"
        }
      },
      {
        "name": "target_registry",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.registry"
        }
      },
      {
        "name": "triggers",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.trigger"
        }
      },
      {
        "name": "workflow_path",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.path"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "repo",
      "direction": "forward",
      "from_binding": "target",
      "predicate": "security.target.source_repo",
      "required": false,
      "target_subject_kinds": [
        "security.repo"
      ]
    },
    {
      "binding": "coverage",
      "direction": "reverse",
      "from_binding": "repo",
      "predicate": "security.coverage.of",
      "required": false,
      "target_subject_kinds": [
        "security.coverage"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "ci.workflows"
        },
        "value_type": "string"
      }
    },
    {
      "binding": "job",
      "direction": "reverse",
      "from_binding": "target",
      "predicate": "security.job.publishes_to",
      "required": false,
      "target_subject_kinds": [
        "security.job"
      ]
    },
    {
      "binding": "workflow",
      "direction": "forward",
      "from_binding": "job",
      "predicate": "security.job.workflow",
      "required": false,
      "target_subject_kinds": [
        "security.workflow"
      ]
    },
    {
      "binding": "job_coverage",
      "direction": "forward",
      "from_binding": "workflow",
      "predicate": "security.workflow.coverage",
      "required": false,
      "target_subject_kinds": [
        "security.coverage"
      ]
    }
  ],
  "where": {
    "binding": "target",
    "kind": "claim_presence",
    "predicate": "security.target.publish_gate"
  }
}
