{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 500,
    "max_traversal_depth": 10
  },
  "description": "One repository (by forge host and owner/repository) and the targets published from it: the repo parse's tap. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "repo",
    "subject_kinds": [
      "security.repo"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.repo_targets"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "forge_host",
      "value_type": "string"
    },
    {
      "name": "full_name",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "forge_host",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.forge_host"
        }
      },
      {
        "name": "full_name",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.full_name"
        }
      },
      {
        "name": "name",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.name"
        }
      },
      {
        "name": "registry",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.registry"
        }
      },
      {
        "name": "repo",
        "value": {
          "binding": "repo",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "target",
        "value": {
          "binding": "target",
          "field": "subject_id",
          "kind": "subject_field"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "target",
      "direction": "reverse",
      "from_binding": "repo",
      "predicate": "security.target.source_repo",
      "required": false,
      "target_subject_kinds": [
        "security.target"
      ]
    }
  ],
  "where": {
    "filters": [
      {
        "kind": "comparison",
        "left": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.forge_host"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "forge_host"
        },
        "value_type": "string"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.full_name"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "full_name"
        },
        "value_type": "string"
      }
    ],
    "kind": "all_of"
  }
}
