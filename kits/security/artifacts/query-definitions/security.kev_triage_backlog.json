{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 200,
    "max_traversal_depth": 10
  },
  "description": "Assessments of KEV-listed vulnerabilities still unresolved (no status, or inconclusive). Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "assessment",
    "subject_kinds": [
      "security.assessment"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.kev_triage_backlog"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "assessment",
        "value": {
          "binding": "assessment",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "status",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "vulnerability",
        "value": {
          "binding": "vulnerability",
          "field": "subject_id",
          "kind": "subject_field"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "vulnerability",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.vulnerability",
      "target_subject_kinds": [
        "security.vulnerability"
      ]
    },
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.release",
      "required": false,
      "target_subject_kinds": [
        "security.release"
      ]
    }
  ],
  "where": {
    "filters": [
      {
        "filters": [
          {
            "binding": "assessment",
            "kind": "claim_presence",
            "negated": true,
            "predicate": "security.assessment.status"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "assessment",
              "kind": "claim_value",
              "predicate": "security.assessment.status"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "inconclusive"
            },
            "value_type": "string"
          }
        ],
        "kind": "any_of"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_listed"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": true
        },
        "value_type": "boolean"
      }
    ],
    "kind": "all_of"
  }
}
