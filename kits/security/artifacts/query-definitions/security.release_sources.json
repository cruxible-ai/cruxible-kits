{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "Every release a registry target serves (an artifact of it), with the repository that target is published from: the CVE record matcher compares an affected entry's repo with it. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "release",
    "subject_kinds": [
      "security.release"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.release_sources"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "forge_host",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.forge_host"
        }
      },
      {
        "name": "full_name",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.full_name"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "repo",
        "value": {
          "binding": "repo",
          "field": "subject_id",
          "kind": "subject_field"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "artifact",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.artifact.release",
      "target_subject_kinds": [
        "security.artifact"
      ]
    },
    {
      "binding": "target",
      "direction": "forward",
      "from_binding": "artifact",
      "predicate": "security.artifact.target",
      "target_subject_kinds": [
        "security.target"
      ]
    },
    {
      "binding": "repo",
      "direction": "forward",
      "from_binding": "target",
      "predicate": "security.target.source_repo",
      "target_subject_kinds": [
        "security.repo"
      ]
    }
  ]
}
