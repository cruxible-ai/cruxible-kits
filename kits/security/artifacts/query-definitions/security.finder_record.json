{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "subject",
  "description": "Every finding of one repository with the finders and rules that reported it and its verdict (conflict while disputed): the reader counts upheld (confirmed, not_exploitable) against overturned (false_positive) per finder or rule. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "finding",
    "subject_kinds": [
      "security.finding"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.finder_record"
  },
  "maximum_budgets": {
    "max_results": 2000,
    "max_traversal_depth": 1
  },
  "parameters": [
    {
      "name": "repo_ref",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "finding",
        "value": {
          "binding": "finding",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "justification",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.justification"
        }
      },
      {
        "name": "locus",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.locus"
        }
      },
      {
        "name": "reported_by",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.reported_by"
        }
      },
      {
        "name": "rules",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.rule"
        }
      },
      {
        "name": "verdict",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.verdict"
        }
      },
      {
        "name": "verification",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.verification"
        }
      },
      {
        "name": "weakness",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.weakness"
        }
      }
    ]
  },
  "result_shape": "subject",
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "finding",
      "kind": "claim_value",
      "predicate": "security.finding.repo_ref"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "repo_ref"
    },
    "value_type": "string"
  }
}
