{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "description": "Every finding of one repository not verified fixed, with its verdict (conflict while disputed), justification, severity, location, finders and remediation. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "finding",
    "subject_kinds": [
      "security.finding"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.open_findings"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "repo_ref",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "finding",
        "value": {
          "binding": "finding",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "justification",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.justification"
        }
      },
      {
        "name": "location",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.location"
        }
      },
      {
        "name": "locus",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.locus"
        }
      },
      {
        "name": "progress",
        "value": {
          "binding": "remediation",
          "kind": "claim_value",
          "predicate": "security.remediation.progress"
        }
      },
      {
        "name": "remediation",
        "value": {
          "binding": "remediation",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "reported_by",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.reported_by"
        }
      },
      {
        "name": "reproduction",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.reproduction"
        }
      },
      {
        "name": "rules",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.rule"
        }
      },
      {
        "name": "severity",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.severity"
        }
      },
      {
        "name": "verdict",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.verdict"
        }
      },
      {
        "name": "verification",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.verification"
        }
      },
      {
        "name": "weakness",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.weakness"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "remediation",
      "direction": "reverse",
      "from_binding": "finding",
      "predicate": "security.work.finding",
      "required": false,
      "target_subject_kinds": [
        "security.remediation"
      ]
    }
  ],
  "where": {
    "filters": [
      {
        "filters": [
          {
            "binding": "finding",
            "kind": "claim_presence",
            "negated": true,
            "predicate": "security.finding.verification"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "finding",
              "kind": "claim_value",
              "predicate": "security.finding.verification"
            },
            "operator": "ne",
            "right": {
              "kind": "literal",
              "value": "fixed"
            },
            "value_type": "string"
          }
        ],
        "kind": "any_of"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.repo_ref"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "repo_ref"
        },
        "value_type": "string"
      }
    ],
    "kind": "all_of"
  }
}
