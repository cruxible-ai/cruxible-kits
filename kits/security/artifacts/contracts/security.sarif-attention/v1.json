{
  "artifact_format": "cruxible-contract-v1",
  "description": "A code-findings item for an agent: a regression (a finding verified fixed that a scan reports again) or a location gap (a result with no repository path or no stable locator, so it is no finding yet).",
  "fields": {
    "finding": {
      "optional": true,
      "type": {
        "kind": "string",
        "max_len": 256
      }
    },
    "kind": {
      "type": {
        "kind": "enum",
        "members": [
          "location_gap",
          "regression"
        ]
      }
    },
    "locus": {
      "optional": true,
      "type": {
        "kind": "string",
        "max_len": 256
      }
    },
    "path": {
      "type": {
        "kind": "string",
        "max_len": 256
      }
    },
    "reason": {
      "optional": true,
      "type": {
        "kind": "string",
        "max_len": 64
      }
    },
    "ref": {
      "type": {
        "kind": "string",
        "max_len": 512
      }
    },
    "repo": {
      "type": {
        "kind": "string",
        "max_len": 256
      }
    },
    "rule": {
      "type": {
        "kind": "string",
        "max_len": 256
      }
    },
    "weakness": {
      "optional": true,
      "type": {
        "kind": "string",
        "max_len": 256
      }
    }
  },
  "name": "security.sarif-attention",
  "version": 1
}
