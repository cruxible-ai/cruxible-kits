     "line": "security.kev-triage"
    },
    {
     "line": "security.epss-triage"
    }
   ]
  },
  {
   "kind": "runbook",
   "name": "security.maintain",
   "description": "Daily refresh: ask OSV what affects the inventory, then read KEV and EPSS for what it found.",
   "steps": [
    {
     "line": "security.osv-query"
    },
    {
     "line": "security.kev-triage"
    },
    {
     "line": "security.epss-triage"
    }
   ]
  },
