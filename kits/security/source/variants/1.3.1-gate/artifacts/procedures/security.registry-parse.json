{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 16777216,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-registry-parse-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-registry-parse-summary"
      }
    },
    "description": "Read the PyPI release Capture that triggered the Line (security.fetched-v1) for the Line's project (parameters: source pypi/PROJECT, project, versions) and propose what changed: each served file as an artifact with its digest, release, and (from provenance) the workflow at the commit that published it, its environment and the commit; the target's source repository; the coverage restated. Halts other_source for another project. Runs as a Line with trigger_input registry.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 5000,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.registry-parse",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.fetched-v1"
          }
        },
        "id": "registry",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.pypi-release/v1"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "security-sources-provider/56caaa4d2c2b4e95421ca1927fdce2c4a6132ca237d2db12c1e9ca046d0c75e3"
          }
        },
        "request": {
          "project": "$input.project",
          "versions": "$input.versions"
        }
      },
      {
        "id": "mine",
        "kind": "guard",
        "message": "The landed release is another project's.",
        "on_false": "other",
        "predicate": {
          "left": {
            "alias": "registry",
            "kind": "step",
            "path": [
              "project"
            ]
          },
          "operator": "eq",
          "right": {
            "input_name": "project",
            "kind": "input"
          }
        },
        "refusal_code": "other_source"
      },
      {
        "id": "coverage",
        "kind": "state_tap",
        "parameters": {
          "scope": "registry.files",
          "source": "$input.source"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.coverage_index"
          }
        }
      },
      {
        "id": "held",
        "kind": "state_tap",
        "parameters": {
          "name": "$input.project",
          "registry": "pypi"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.registry_facts"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "coverage": "$steps.coverage.result.rows",
          "held": "$steps.held.result.rows",
          "release": "$steps.registry"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.registry-facts/v1"
          }
        },
        "kind": "call",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "security-analysis-provider/a250c95f355f9aebf5212848004e70597af75d4093f1302ea2ff6883ee0e1b1f"
          }
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-registry-parse-summary"
          }
        },
        "fields": {
          "added": "$steps.parse.added",
          "changed": "$steps.parse.changed",
          "files": "$steps.parse.files",
          "locator": "$steps.parse.locator",
          "restated": "$steps.parse.restated",
          "retired": "$steps.parse.retired",
          "revised": "$steps.parse.revised",
          "revision": "$steps.parse.revision"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "candidate_templates": {
          "items": "$steps.parse.items"
        },
        "id": "propose",
        "kind": "propose_change_set",
        "result": "$steps.summary"
      },
      {
        "id": "other",
        "kind": "halt",
        "reason": "other_source"
      }
    ],
    "returns": "summary",
    "terminal_capability": 2
  },
  "definition_digest": "sha256:f141611d431a4142270245173c17cea49ee8cfe626e6ff4884275eab454dcaf0",
  "identity": {
    "kind": "Procedure",
    "name": "security.registry-parse"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-registry-parse-input"
      },
      "schema": {
        "fields": {
          "project": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "versions": {
            "type": "integer"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-registry-parse-summary"
      },
      "schema": {
        "fields": {
          "added": {
            "type": "integer"
          },
          "changed": {
            "type": "integer"
          },
          "files": {
            "type": "integer"
          },
          "locator": {
            "type": "string"
          },
          "restated": {
            "type": "integer"
          },
          "retired": {
            "type": "integer"
          },
          "revised": {
            "type": "integer"
          },
          "revision": {
            "type": "string"
          }
        }
      }
    }
  ]
}
