{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 16777216,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-empty-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-kev-attention-summary"
      }
    },
    "description": "Read the KEV catalog Capture that triggered the Line and post one inbox item per CVE added in the catalog's last 7 days whose vendor/product matches a release in inventory that nobody watches the CVE for or nobody has assessed: possibly exposed, nobody has looked. Never changes accepted state. Runs as a Line with trigger_input catalog.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 1000,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.kev-attention",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.fetched-v1"
          }
        },
        "id": "catalog",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "web.fetch/v3"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "cruxible-provider-web/ddc99c153ce3ca4226d991f11ab40f1d96fa0ad4364c8918f8aa82b0c840218b"
          }
        },
        "request": {
          "expected_format": "json",
          "extract": false,
          "logical_source": "cisa.kev.catalog",
          "max_bytes": 4194304,
          "render": false,
          "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
        }
      },
      {
        "id": "releases",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.release_inventory"
          }
        }
      },
      {
        "id": "watched",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.watched_vulnerabilities"
          }
        }
      },
      {
        "id": "assessments",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.assessment_index"
          }
        }
      },
      {
        "id": "match",
        "input": {
          "assessments": "$steps.assessments.result.rows",
          "catalog_base64": "$steps.catalog.retrieved.body_base64",
          "releases": "$steps.releases.result.rows",
          "watched": "$steps.watched.result.rows"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.kev-attention/v1"
          }
        },
        "kind": "call",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "security-analysis-provider/a250c95f355f9aebf5212848004e70597af75d4093f1302ea2ff6883ee0e1b1f"
          }
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-kev-attention-summary"
          }
        },
        "fields": {
          "catalog_version": "$steps.match.catalog_version",
          "newly_listed": "$steps.match.newly_listed",
          "posted": "$steps.match.posted"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "posted",
        "kind": "guard",
        "message": "No newly listed CVE matches unwatched or unassessed inventory.",
        "on_false": "quiet",
        "predicate": {
          "left": {
            "alias": "match",
            "kind": "step",
            "path": [
              "posted"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "nothing_to_post"
      },
      {
        "id": "post",
        "input": {
          "items": "$steps.match.items"
        },
        "kind": "post_inbox",
        "max_items": 1000
      },
      {
        "id": "quiet",
        "kind": "halt",
        "reason": "nothing_to_post"
      }
    ],
    "returns": "summary",
    "terminal_capability": 1
  },
  "definition_digest": "sha256:8defa6d1495c99959e330f3f642893a05b11812d978e6e4fd83476c86b63e5d5",
  "identity": {
    "kind": "Procedure",
    "name": "security.kev-attention"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-empty-input"
      },
      "schema": {
        "fields": {}
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-kev-attention-summary"
      },
      "schema": {
        "fields": {
          "catalog_version": {
            "type": "string"
          },
          "newly_listed": {
            "type": "integer"
          },
          "posted": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
