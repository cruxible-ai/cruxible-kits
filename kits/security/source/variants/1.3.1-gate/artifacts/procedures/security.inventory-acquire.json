{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 1048576,
      "max_provider_calls": 1,
      "wall_clock": {
        "microseconds": 60000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-path-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-file-evidence"
      }
    },
    "description": "Read one runtime-inventory scan from the attached workspace (input.relative_path, at most 1 MiB) and retain it under security.file-erasable-v1; the scope's security.inventory-import Line reads it when it lands. Either the kit's tool-neutral body {scope, looked_for, coverage: full|partial, assets: [{hostname, runs: [purl@version]}]} with no timestamps (an unchanged fleet is the same bytes), or a CycloneDX JSON SBOM of one asset (Syft, Trivy) annotated with metadata properties cruxible.scope and cruxible.asset.",
    "hard_caps": {
      "max_capture_bytes": 1048576,
      "max_items": 1,
      "max_provider_calls": 1,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "security.inventory-acquire",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.file-erasable-v1"
          }
        },
        "id": "inventory",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "cruxible-builtin"
          }
        },
        "request": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "security.inventory",
          "relative_path": "$input.relative_path",
          "replayability": "exact",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-file-evidence"
          }
        },
        "fields": {
          "byte_length": "$steps.inventory.source.byte_length",
          "bytes_digest": "$steps.inventory.source.bytes_digest"
        },
        "id": "summary",
        "kind": "project"
      }
    ],
    "returns": "summary",
    "terminal_capability": 1
  },
  "definition_digest": "sha256:8864c3bb05bf562004d5f7cced66d2101219b54fb20732e18a6cbff65a61ea8a",
  "identity": {
    "kind": "Procedure",
    "name": "security.inventory-acquire"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-file-evidence"
      },
      "schema": {
        "fields": {
          "byte_length": {
            "type": "integer"
          },
          "bytes_digest": {
            "type": "string"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-path-input"
      },
      "schema": {
        "fields": {
          "relative_path": {
            "type": "string"
          }
        }
      }
    }
  ]
}
