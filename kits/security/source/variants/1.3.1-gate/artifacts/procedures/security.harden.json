{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 1048576,
      "max_provider_calls": 1,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-harden-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-harden-summary"
      }
    },
    "description": "Ask the six hardening questions (HQ1-HQ6) about every gated target (a target with a security.target.publish_gate) and answer each in three states: found (posted as a finding), none (a current coverage answers it; run summary only) or unknown (posted as one gap item per source, naming the pull: {source, pull, input}). HQ6 (an open confirmed code finding in a release the target serves) is found or not recorded, never none. Observe-only. Runs as a Line (parameters: default_ref, repo_pull, registry_pull, release_pull, versions): daily, on a pull landing, or line run.",
    "hard_caps": {
      "max_capture_bytes": 1048576,
      "max_items": 200,
      "max_provider_calls": 1,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.harden",
    "nodes": [
      {
        "id": "hq1",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.publish_paths"
          }
        }
      },
      {
        "id": "hq2",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.credentialed_jobs"
          }
        }
      },
      {
        "id": "hq3",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.mutable_actions"
          }
        }
      },
      {
        "id": "hq4",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.shared_dependencies"
          }
        }
      },
      {
        "id": "hq5",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.served_vs_declared"
          }
        }
      },
      {
        "id": "hq6",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.published_findings"
          }
        }
      },
      {
        "id": "classify",
        "input": {
          "hq1": "$steps.hq1.result.rows",
          "hq2": "$steps.hq2.result.rows",
          "hq3": "$steps.hq3.result.rows",
          "hq4": "$steps.hq4.result.rows",
          "hq5": "$steps.hq5.result.rows",
          "hq6": "$steps.hq6.result.rows",
          "params": "$input",
          "truncated": {
            "hq1": "$steps.hq1.truncated",
            "hq2": "$steps.hq2.truncated",
            "hq3": "$steps.hq3.truncated",
            "hq4": "$steps.hq4.truncated",
            "hq5": "$steps.hq5.truncated",
            "hq6": "$steps.hq6.truncated"
          }
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.harden/v1"
          }
        },
        "kind": "call",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "security-analysis-provider/a250c95f355f9aebf5212848004e70597af75d4093f1302ea2ff6883ee0e1b1f"
          }
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-harden-summary"
          }
        },
        "fields": {
          "answers": "$steps.classify.answers",
          "found": "$steps.classify.found",
          "gaps": "$steps.classify.gaps",
          "none": "$steps.classify.none",
          "posted": "$steps.classify.posted",
          "targets": "$steps.classify.targets",
          "unknown": "$steps.classify.unknown"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "posted",
        "kind": "guard",
        "message": "Every hardening answer is none: nothing to post.",
        "on_false": "quiet",
        "predicate": {
          "left": {
            "alias": "classify",
            "kind": "step",
            "path": [
              "posted"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "nothing_to_post"
      },
      {
        "id": "post",
        "input": {
          "items": "$steps.classify.items"
        },
        "kind": "post_inbox",
        "max_items": 200
      },
      {
        "id": "quiet",
        "kind": "halt",
        "reason": "nothing_to_post"
      }
    ],
    "returns": "summary",
    "terminal_capability": 1
  },
  "definition_digest": "sha256:ca376d794999fa1aa90a13b31203f3f08915639d31ed3f39b0bdc0223f655e7a",
  "identity": {
    "kind": "Procedure",
    "name": "security.harden"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-harden-input"
      },
      "schema": {
        "fields": {
          "default_ref": {
            "type": "string"
          },
          "registry_pull": {
            "type": "string"
          },
          "release_pull": {
            "type": "string"
          },
          "repo_pull": {
            "type": "string"
          },
          "versions": {
            "type": "integer"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-harden-summary"
      },
      "schema": {
        "fields": {
          "answers": {
            "type": "json"
          },
          "found": {
            "type": "integer"
          },
          "gaps": {
            "type": "integer"
          },
          "none": {
            "type": "integer"
          },
          "posted": {
            "type": "integer"
          },
          "targets": {
            "type": "integer"
          },
          "unknown": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
