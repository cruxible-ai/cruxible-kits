{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 1048576,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-inventory-import-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-runtime-inventory-summary"
      }
    },
    "description": "Read the runtime-inventory Capture that triggered the Line (security.file-erasable-v1) for the Line's scope (parameter scope) and propose what changed: each asset by key and asset.scanned_in the scope's coverage, each release it runs (by product name, the purl's whole namespace and name, and version, with its purl as release.component) as asset.runs; a full scan retires runs it no longer sees (of the products it looked for) and restates the coverage revision (an unchanged scan re-observes it: freshness moves, nothing is proposed). A complete read states each asset's nones (asset.runs inverses): every product it named in looked_for that the asset does not run, and under * every product the asset ran before and no longer does (the run retires in the same change: a flip) or declares installing and does not run; a held none is restated (refreshed), retired when the product runs again or the scan no longer looks for it. For each open patch of a scanned asset: verification verified when a full scan shows the affected release no longer running, failed when it is claimed completed and a scan still shows it. A CycloneDX SBOM of one asset (metadata properties cruxible.scope, cruxible.asset) reads as that asset's complete run set, never as the scope's coverage, and only while every component is identified (a purl with a version, an OS component too): one that isn't could be any product, so the SBOM then only adds (unidentified counts them). Two ecosystems' packages of one name and version are one release with both purls as components. Halts other_scope for another scope's scan, no_change when nothing changed. Runs as a Line with trigger_input inventory.",
    "hard_caps": {
      "max_capture_bytes": 1048576,
      "max_items": 5000,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.inventory-import",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.file-erasable-v1"
          }
        },
        "id": "inventory",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "cruxible-builtin"
          }
        },
        "request": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "security.inventory",
          "relative_path": "inventory.json",
          "replayability": "exact",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        }
      },
      {
        "id": "held",
        "kind": "state_tap",
        "parameters": {
          "scope": "$input.scope"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.inventory_index"
          }
        }
      },
      {
        "id": "runs",
        "kind": "state_tap",
        "parameters": {
          "scope": "$input.scope"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.inventory_runs"
          }
        }
      },
      {
        "id": "patches",
        "kind": "state_tap",
        "parameters": {
          "scope": "$input.scope"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.inventory_patches"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "held": "$steps.held.result.rows",
          "inventory_text": "$steps.inventory.content.text",
          "osv_ecosystems": {
            "apk/alpine": "Alpine",
            "apk/chainguard": "Chainguard",
            "apk/wolfi": "Wolfi",
            "bitnami": "Bitnami",
            "cargo": "crates.io",
            "composer": "Packagist",
            "conan": "ConanCenter",
            "cran": "CRAN",
            "deb/debian": "Debian",
            "deb/ubuntu": "Ubuntu",
            "gem": "RubyGems",
            "githubactions": "GitHub Actions",
            "golang": "Go",
            "hackage": "Hackage",
            "hex": "Hex",
            "maven": "Maven",
            "npm": "npm",
            "nuget": "NuGet",
            "pub": "Pub",
            "pypi": "PyPI",
            "rpm/almalinux": "AlmaLinux",
            "rpm/mageia": "Mageia",
            "rpm/openeuler": "openEuler",
            "rpm/opensuse": "openSUSE",
            "rpm/redhat": "Red Hat",
            "rpm/rocky-linux": "Rocky Linux",
            "rpm/suse": "SUSE",
            "swift": "SwiftURL"
          },
          "patches": "$steps.patches.result.rows",
          "runs": "$steps.runs.result.rows",
          "scope": "$input.scope",
          "truncated": {
            "held": "$steps.held.truncated",
            "patches": "$steps.patches.truncated",
            "runs": "$steps.runs.truncated"
          }
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.runtime-inventory/v1"
          }
        },
        "kind": "call",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "security-analysis-provider/a250c95f355f9aebf5212848004e70597af75d4093f1302ea2ff6883ee0e1b1f"
          }
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-runtime-inventory-summary"
          }
        },
        "fields": {
          "added": "$steps.parse.added",
          "assets": "$steps.parse.assets",
          "changed": "$steps.parse.changed",
          "coverage": "$steps.parse.coverage",
          "failed": "$steps.parse.failed",
          "format": "$steps.parse.format",
          "mine": "$steps.parse.mine",
          "nones": "$steps.parse.nones",
          "osv_not_indexed": "$steps.parse.osv_not_indexed",
          "osv_unindexed": "$steps.parse.osv_unindexed",
          "proposes": "$steps.parse.proposes",
          "regressions": "$steps.parse.regressions",
          "restated": "$steps.parse.restated",
          "retired": "$steps.parse.retired",
          "revised": "$steps.parse.revised",
          "revision": "$steps.parse.revision",
          "runs": "$steps.parse.runs",
          "scope": "$steps.parse.scope",
          "unidentified": "$steps.parse.unidentified",
          "verified": "$steps.parse.verified"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "mine",
        "kind": "guard",
        "message": "The landed inventory is another scope's.",
        "on_false": "other",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "mine"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "other_scope"
      },
      {
        "id": "changed",
        "kind": "guard",
        "message": "The scan changes nothing inventory holds.",
        "on_false": "nochange",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "proposes"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "no_change"
      },
      {
        "candidate_templates": {
          "items": "$steps.parse.items"
        },
        "id": "propose",
        "kind": "propose_change_set",
        "result": "$steps.summary"
      },
      {
        "id": "nochange",
        "kind": "halt",
        "reason": "no_change"
      },
      {
        "id": "other",
        "kind": "halt",
        "reason": "other_scope"
      }
    ],
    "returns": "summary",
    "terminal_capability": 2
  },
  "definition_digest": "sha256:3b5e8e09d19fb3f178a1d5e7ec484d1023151a15e6216975c38a960a1ab927fb",
