{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 1048576,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 60000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-empty-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-credential-state-summary"
      }
    },
    "description": "Read the credential-state Capture that triggered the Line (security.file-erasable-v1) and propose what changed: the credential's current key_id, issued_at and issued_by from a receipt or a state read; revoked_key and a rotation's verification only from a state read (verified: the rotation's revokes_key is listed revoked or deleted, or absent from a listing that says complete, and an active key was issued after the incident's window_start; failed: claimed completed while revokes_key is still listed). A body outside the allow-list, or a key id, issuer, name or principal shaped like a secret, proposes nothing and is posted (secret_shape, with a fixed message: nothing from the body is echoed). Runs as a Line with trigger_input credential.",
    "hard_caps": {
      "max_capture_bytes": 1048576,
      "max_items": 500,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "security.credential-import",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.file-erasable-v1"
          }
        },
        "id": "credential",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "kind": "source",
        "provider": {
          "slot_name": "credential"
        },
        "request": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "security.credential-state",
          "relative_path": "credential.json",
          "replayability": "exact",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        }
      },
      {
        "id": "held",
        "kind": "state_tap",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.rotation_work"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "held": "$steps.held.result.rows",
          "state_text": "$steps.credential.content.text",
          "truncated": "$steps.held.truncated"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.credential-state/v1"
          }
        },
        "kind": "call",
        "provider": {
          "slot_name": "parse"
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-credential-state-summary"
          }
        },
        "fields": {
          "added": "$steps.parse.added",
          "changed": "$steps.parse.changed",
          "credential": "$steps.parse.credential",
          "failed": "$steps.parse.failed",
          "keys": "$steps.parse.keys",
          "posted": "$steps.parse.posted",
          "read": "$steps.parse.read",
          "revised": "$steps.parse.revised",
          "unproven": "$steps.parse.unproven",
          "verified": "$steps.parse.verified"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "allowed",
        "kind": "guard",
        "message": "The body is not the credential-state allow-list.",
        "on_false": "post",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "posted"
            ]
          },
          "operator": "eq",
          "right": 0
        },
        "refusal_code": "secret_shape"
      },
      {
        "id": "changed",
        "kind": "guard",
        "message": "The read changes no held key state.",
        "on_false": "nochange",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "changed"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "no_change"
      },
      {
        "candidate_templates": {
          "items": "$steps.parse.items"
        },
        "id": "propose",
        "kind": "propose_change_set",
        "result": "$steps.summary"
      },
      {
        "id": "post",
        "input": {
          "items": "$steps.parse.inbox"
        },
        "kind": "post_inbox",
        "max_items": 10
      },
      {
        "id": "nochange",
        "kind": "halt",
        "reason": "no_change"
      }
    ],
    "pin_slots": [
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "slot_name": "credential"
      },
      {
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.credential-state/v1"
          }
        },
        "slot_name": "parse"
      }
    ],
    "returns": "summary",
    "terminal_capability": 2
  },
  "definition_digest": "sha256:8b279630e187c8d05aa1f89b8d5fcc114766fafc343a06a348105578e926c996",
  "identity": {
    "kind": "Procedure",
    "name": "security.credential-import"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-credential-state-summary"
      },
      "schema": {
        "fields": {
          "added": {
            "type": "integer"
          },
          "changed": {
            "type": "integer"
          },
          "credential": {
            "type": "string"
          },
          "failed": {
            "type": "integer"
          },
          "keys": {
            "type": "integer"
          },
          "posted": {
            "type": "integer"
          },
          "read": {
            "type": "string"
          },
          "revised": {
            "type": "integer"
          },
          "unproven": {
            "type": "integer"
          },
          "verified": {
            "type": "integer"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-empty-input"
      },
      "schema": {
        "fields": {}
      }
    }
  ]
}
