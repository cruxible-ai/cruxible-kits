{
  "activation_policy": "drain",
  "artifact_format": "cruxible-procedure-v3",
  "definition": {
    "budget": {
      "max_capture_bytes": 16777216,
      "max_provider_calls": 2,
      "wall_clock": {
        "microseconds": 120000000
      }
    },
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "security-sarif-import-input"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "security-sarif-summary"
      }
    },
    "description": "Read the SARIF log Capture that triggered the Line for the Line's repository (parameter repo_ref) and post one inbox item per location gap (a result with no repository-relative path or no stable locus: one per tool, rule and path) and per regression (a fixed finding a full scan reports again). Never changes accepted state. Runs as a Line with trigger_input sarif, beside security.sarif-import.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 1000,
      "max_provider_calls": 2,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 300000000
      }
    },
    "name": "security.sarif-attention",
    "nodes": [
      {
        "capture_contract": {
          "target": {
            "kind": "CaptureContract",
            "name": "security.file-v1"
          }
        },
        "id": "sarif",
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "workspace.file"
          }
        },
        "kind": "source",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "cruxible-builtin"
          }
        },
        "request": {
          "coordinate": {
            "revision": "working"
          },
          "coordinate_type": "http-response-v1",
          "logical_source": "sarif.log",
          "relative_path": "scan.sarif",
          "replayability": "exact",
          "selector": {
            "whole": true
          },
          "selector_type": "whole-response-v1",
          "tag": "playbill-workspace-file-source-request-v2"
        }
      },
      {
        "id": "held",
        "kind": "state_tap",
        "parameters": {
          "repo_ref": "$input.repo_ref"
        },
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "security.finding_index"
          }
        }
      },
      {
        "id": "parse",
        "input": {
          "held": "$steps.held.result.rows",
          "repo_ref": "$input.repo_ref",
          "sarif_text": "$steps.sarif.content.text",
          "truncated": "$steps.held.truncated"
        },
        "interface": {
          "target": {
            "kind": "ProviderInterface",
            "name": "security.sarif-findings/v1"
          }
        },
        "kind": "call",
        "provider": {
          "target": {
            "kind": "Provider",
            "name": "security-analysis-provider/a250c95f355f9aebf5212848004e70597af75d4093f1302ea2ff6883ee0e1b1f"
          }
        }
      },
      {
        "contract_out": {
          "target": {
            "kind": "Contract",
            "name": "security-sarif-summary"
          }
        },
        "fields": {
          "added": "$steps.parse.added",
          "changed": "$steps.parse.changed",
          "findings": "$steps.parse.findings",
          "fixed": "$steps.parse.fixed",
          "full": "$steps.parse.full",
          "gaps": "$steps.parse.gaps",
          "mine": "$steps.parse.mine",
          "new": "$steps.parse.new",
          "posted": "$steps.parse.posted",
          "regressed": "$steps.parse.regressed",
          "repo_ref": "$steps.parse.repo_ref",
          "results": "$steps.parse.results",
          "revisions": "$steps.parse.revisions",
          "routed_to_assessment": "$steps.parse.routed_to_assessment",
          "tools": "$steps.parse.tools"
        },
        "id": "summary",
        "kind": "project"
      },
      {
        "id": "mine",
        "kind": "guard",
        "message": "The landed SARIF log has no run of the Line's repository.",
        "on_false": "other",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "mine"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "wrong_repo"
      },
      {
        "id": "posted",
        "kind": "guard",
        "message": "The scan has no location gap and no regression.",
        "on_false": "quiet",
        "predicate": {
          "left": {
            "alias": "parse",
            "kind": "step",
            "path": [
              "posted"
            ]
          },
          "operator": "gt",
          "right": 0
        },
        "refusal_code": "nothing_to_post"
      },
      {
        "id": "post",
        "input": {
          "items": "$steps.parse.inbox"
        },
        "kind": "post_inbox",
        "max_items": 1000
      },
      {
        "id": "quiet",
        "kind": "halt",
        "reason": "nothing_to_post"
      },
      {
        "id": "other",
        "kind": "halt",
        "reason": "wrong_repo"
      }
    ],
    "returns": "summary",
    "terminal_capability": 1
  },
  "definition_digest": "sha256:63542837bcba815a8d6220e1b9d6847ec69b9158d5571119b0044bdbe310c33e",
  "identity": {
    "kind": "Procedure",
    "name": "security.sarif-attention"
  },
  "owned_contracts": [
    {
      "identity": {
        "kind": "Contract",
        "name": "security-sarif-import-input"
      },
      "schema": {
        "fields": {
          "repo_ref": {
            "type": "string"
          }
        }
      }
    },
    {
      "identity": {
        "kind": "Contract",
        "name": "security-sarif-summary"
      },
      "schema": {
        "fields": {
          "added": {
            "type": "integer"
          },
          "changed": {
            "type": "integer"
          },
          "findings": {
            "type": "integer"
          },
          "fixed": {
            "type": "integer"
          },
          "full": {
            "type": "json"
          },
          "gaps": {
            "type": "integer"
          },
          "mine": {
            "type": "integer"
          },
          "new": {
            "type": "integer"
          },
          "posted": {
            "type": "integer"
          },
          "regressed": {
            "type": "integer"
          },
          "repo_ref": {
            "type": "string"
          },
          "results": {
            "type": "integer"
          },
          "revisions": {
            "type": "json"
          },
          "routed_to_assessment": {
            "type": "integer"
          },
          "tools": {
            "type": "json"
          }
        }
      }
    }
  ]
}
