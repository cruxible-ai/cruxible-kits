{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 500,
    "max_results": 500,
    "max_traversal_depth": 10
  },
  "description": "The incident status page: per CVE and exposure (affected first), each host a scan observed running it (exposed_host), each patch or unexpired exception (excepted_until) with its asset (host), progress and verification, and per audit of the incident its service, result and each credential's rotation progress and verification (pending is its own state). Empty is unknown. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "incident",
    "subject_kinds": [
      "security.incident"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.incident_status"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "orderings": [
    {
      "key": {
        "binding": "assessment",
        "kind": "claim_value",
        "predicate": "security.assessment.status"
      },
      "value_type": "string"
    }
  ],
  "parameters": [
    {
      "name": "incident",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "audit",
        "value": {
          "binding": "audit",
          "kind": "claim_value",
          "predicate": "security.audit.result"
        }
      },
      {
        "name": "audit_service",
        "value": {
          "binding": "audited",
          "kind": "claim_value",
          "predicate": "security.service.name"
        }
      },
      {
        "name": "credential",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.name"
        }
      },
      {
        "name": "cve",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.cve_id"
        }
      },
      {
        "name": "excepted_until",
        "value": {
          "binding": "work",
          "kind": "claim_value",
          "predicate": "security.exception.expires_at"
        }
      },
      {
        "name": "exposed_host",
        "value": {
          "binding": "exposed",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "exposure",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "host",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "patch",
        "value": {
          "binding": "work",
          "kind": "claim_value",
          "predicate": "security.remediation.progress"
        }
      },
      {
        "name": "patch_verified",
        "value": {
          "binding": "work",
          "kind": "claim_value",
          "predicate": "security.work.verification"
        }
      },
      {
        "name": "rotation",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.remediation.progress"
        }
      },
      {
        "name": "rotation_verified",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.work.verification"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "vulnerability",
      "direction": "forward",
      "from_binding": "incident",
      "predicate": "security.incident.vulnerability",
      "target_subject_kinds": [
        "security.vulnerability"
      ]
    },
    {
      "binding": "assessment",
      "direction": "reverse",
      "from_binding": "vulnerability",
      "predicate": "security.assessment.vulnerability",
      "target_subject_kinds": [
        "security.assessment"
      ],
      "where": {
        "filters": [
          {
            "kind": "comparison",
            "left": {
              "binding": "assessment",
              "kind": "claim_value",
              "predicate": "security.assessment.status"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "affected"
            },
            "value_type": "string"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "assessment",
              "kind": "claim_value",
              "predicate": "security.assessment.status"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "inconclusive"
            },
            "value_type": "string"
          }
        ],
        "kind": "any_of"
      }
    },
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.release",
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "exposed",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.asset.runs",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "work",
      "direction": "reverse",
      "from_binding": "assessment",
      "predicate": "security.work.assessment",
      "required": false,
      "target_subject_kinds": [
        "security.exception",
        "security.remediation"
      ],
      "where": {
        "filters": [
          {
            "filters": [
              {
                "kind": "comparison",
                "left": {
                  "binding": "work",
                  "kind": "claim_value",
                  "predicate": "security.exception.approval"
                },
                "operator": "eq",
                "right": {
                  "kind": "literal",
                  "value": "approved"
                },
                "value_type": "string"
              },
              {
                "kind": "comparison",
                "left": {
                  "binding": "work",
                  "kind": "claim_value",
                  "predicate": "security.exception.expires_at"
                },
                "operator": "gt",
                "right": {
                  "kind": "evaluation_time"
                },
                "value_type": "timestamp"
              }
            ],
            "kind": "all_of"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "work",
              "field": "subject_kind",
              "kind": "subject_field"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "security.remediation"
            },
            "value_type": "string"
          }
        ],
        "kind": "any_of"
      }
    },
    {
      "binding": "asset",
      "direction": "forward",
      "from_binding": "work",
      "predicate": "security.work.asset",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "audit",
      "direction": "reverse",
      "from_binding": "incident",
      "predicate": "security.audit.incident",
      "required": false,
      "target_subject_kinds": [
        "security.audit"
      ]
    },
    {
      "binding": "audited",
      "direction": "forward",
      "from_binding": "audit",
      "predicate": "security.audit.service",
      "required": false,
      "target_subject_kinds": [
        "security.service"
      ]
    },
    {
      "binding": "credential",
      "direction": "reverse",
      "from_binding": "audited",
      "predicate": "security.credential.used_by",
      "required": false,
      "target_subject_kinds": [
        "security.credential"
      ]
    },
    {
      "binding": "rotation",
      "direction": "reverse",
      "from_binding": "credential",
      "predicate": "security.work.credential",
      "required": false,
      "target_subject_kinds": [
        "security.remediation"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "incident",
      "kind": "claim_value",
      "predicate": "security.incident.name"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "incident"
    },
    "value_type": "string"
  }
}
