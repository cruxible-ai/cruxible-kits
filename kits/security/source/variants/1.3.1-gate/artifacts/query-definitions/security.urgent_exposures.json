{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 500,
    "max_traversal_depth": 10
  },
  "description": "Every release assessed affected, KEV-listed first, then by EPSS score, with the hosts that declare installing it (asset; asset_observed is set when a scan also observed it running there: declared and observed) and the hosts a scan observed running it that declare nothing about it (observed: observed only). A release with both kinds pairs each declaring host with each observed-only one. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "assessment",
    "subject_kinds": [
      "security.assessment"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.urgent_exposures"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "orderings": [
    {
      "direction": "descending",
      "key": {
        "binding": "vulnerability",
        "kind": "claim_value",
        "predicate": "security.vulnerability.kev_listed"
      },
      "value_type": "boolean"
    },
    {
      "direction": "descending",
      "key": {
        "binding": "vulnerability",
        "kind": "claim_value",
        "predicate": "security.vulnerability.epss_score"
      },
      "value_type": "decimal"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "assessment",
        "value": {
          "binding": "assessment",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "asset_observed",
        "value": {
          "binding": "asset_run",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "component",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.component"
        }
      },
      {
        "name": "criticality",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.criticality"
        }
      },
      {
        "name": "cve_id",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.cve_id"
        }
      },
      {
        "name": "epss_percentile",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.epss_percentile"
        }
      },
      {
        "name": "epss_score",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.epss_score"
        }
      },
      {
        "name": "internet_exposed",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.internet_exposed"
        }
      },
      {
        "name": "kev_due_date",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_due_date"
        }
      },
      {
        "name": "kev_listed",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_listed"
        }
      },
      {
        "name": "observed",
        "value": {
          "binding": "observed",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "observed_criticality",
        "value": {
          "binding": "observed_service",
          "kind": "claim_value",
          "predicate": "security.service.criticality"
        }
      },
      {
        "name": "observed_internet_exposed",
        "value": {
          "binding": "observed",
          "kind": "claim_value",
          "predicate": "security.asset.internet_exposed"
        }
      },
      {
        "name": "observed_service",
        "value": {
          "binding": "observed_service",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "observed_team",
        "value": {
          "binding": "observed_team",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "product_name",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "service",
        "value": {
          "binding": "service",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "status_role",
        "value": {
          "binding": "assessment",
          "field": "role",
          "kind": "claim_field",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "team",
        "value": {
          "binding": "team",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "version",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "vulnerability",
        "value": {
          "binding": "vulnerability",
          "field": "subject_id",
          "kind": "subject_field"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "vulnerability",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.vulnerability",
      "target_subject_kinds": [
        "security.vulnerability"
      ]
    },
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.release",
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "asset",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.asset.installs",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "asset_run",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.asset.runs",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "asset_run",
          "field": "subject_id",
          "kind": "subject_field"
        },
        "operator": "eq",
        "right": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        },
        "value_type": "string"
      }
    },
    {
      "binding": "service",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.serves",
      "required": false,
      "target_subject_kinds": [
        "security.service"
      ]
    },
    {
      "binding": "team",
      "direction": "forward",
      "from_binding": "service",
      "predicate": "security.service.owned_by",
      "required": false,
      "target_subject_kinds": [
        "security.team"
      ]
    },
    {
      "binding": "observed",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.asset.runs",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ],
      "where": {
        "kind": "not",
        "operand": {
          "kind": "comparison",
          "left": {
            "binding": "observed",
            "kind": "claim_value",
            "predicate": "security.asset.installs"
          },
          "operator": "eq",
          "right": {
            "binding": "assessment",
            "kind": "claim_value",
            "predicate": "security.assessment.release"
          },
          "value_type": "subject_reference"
        }
      }
    },
    {
      "binding": "observed_service",
      "direction": "forward",
      "from_binding": "observed",
      "predicate": "security.asset.serves",
      "required": false,
      "target_subject_kinds": [
        "security.service"
      ]
    },
    {
      "binding": "observed_team",
      "direction": "forward",
      "from_binding": "observed_service",
      "predicate": "security.service.owned_by",
      "required": false,
      "target_subject_kinds": [
        "security.team"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "assessment",
      "kind": "claim_value",
      "predicate": "security.assessment.status"
    },
    "operator": "eq",
    "right": {
      "kind": "literal",
      "value": "affected"
    },
    "value_type": "string"
  }
}
