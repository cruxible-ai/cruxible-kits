{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "RQ4 for one incident: every credential an audited service uses, with its current key (non-secret id, issued_at: before window_start = not rotated since exposure) and its rotations' progress and verification. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "incident",
    "subject_kinds": [
      "security.incident"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.incident_credentials"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "incident",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "audit",
        "value": {
          "binding": "audit",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "credential",
        "value": {
          "binding": "credential",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "due_at",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.remediation.due_at"
        }
      },
      {
        "name": "incident",
        "value": {
          "binding": "incident",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "incident_status",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.status"
        }
      },
      {
        "name": "issued_at",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.issued_at"
        }
      },
      {
        "name": "issued_by",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.issued_by"
        }
      },
      {
        "name": "issuer",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.issuer"
        }
      },
      {
        "name": "key_id",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.key_id"
        }
      },
      {
        "name": "name",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.name"
        }
      },
      {
        "name": "progress",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.remediation.progress"
        }
      },
      {
        "name": "revokes_key",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.remediation.revokes_key"
        }
      },
      {
        "name": "rotation",
        "value": {
          "binding": "rotation",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "rotation_audit",
        "value": {
          "binding": "rotation_audit",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "rotation_policy",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.rotation_policy"
        }
      },
      {
        "name": "service",
        "value": {
          "binding": "service",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "service_name",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.name"
        }
      },
      {
        "name": "verification",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.work.verification"
        }
      },
      {
        "name": "window_start",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.window_start"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "audit",
      "direction": "reverse",
      "from_binding": "incident",
      "predicate": "security.audit.incident",
      "target_subject_kinds": [
        "security.audit"
      ]
    },
    {
      "binding": "service",
      "direction": "forward",
      "from_binding": "audit",
      "predicate": "security.audit.service",
      "target_subject_kinds": [
        "security.service"
      ]
    },
    {
      "binding": "credential",
      "direction": "reverse",
      "from_binding": "service",
      "predicate": "security.credential.used_by",
      "target_subject_kinds": [
        "security.credential"
      ]
    },
    {
      "binding": "rotation",
      "direction": "reverse",
      "from_binding": "credential",
      "predicate": "security.work.credential",
      "required": false,
      "target_subject_kinds": [
        "security.remediation"
      ]
    },
    {
      "binding": "rotation_audit",
      "direction": "forward",
      "from_binding": "rotation",
      "predicate": "security.work.audit",
      "required": false,
      "target_subject_kinds": [
        "security.audit"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "incident",
      "kind": "claim_value",
      "predicate": "security.incident.name"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "incident"
    },
    "value_type": "string"
  }
}
