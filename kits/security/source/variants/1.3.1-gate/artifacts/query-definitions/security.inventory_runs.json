{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "Every release an asset scanned in one inventory scope runs, by key, with its components: the runtime-inventory import's second tap (what each held run is). Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "run",
    "subject_kinds": [
      "security.release"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current",
      "stale"
    ],
    "visible_verdicts": [
      "stale",
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.inventory_runs"
  },
  "includes": [
    {
      "binding": "included_run_component",
      "direction": "forward",
      "from_binding": "run",
      "many": true,
      "max_items": 500,
      "name": "run_component",
      "predicate": "security.release.component"
    }
  ],
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "scope",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "hostname",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "run",
        "value": {
          "binding": "run",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "run_product",
        "value": {
          "binding": "run",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "run_version",
        "value": {
          "binding": "run",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "asset",
      "direction": "reverse",
      "from_binding": "run",
      "predicate": "security.asset.runs",
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "coverage",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.scanned_in",
      "target_subject_kinds": [
        "security.coverage"
      ],
      "where": {
        "filters": [
          {
            "kind": "comparison",
            "left": {
              "binding": "coverage",
              "kind": "claim_value",
              "predicate": "security.coverage.scope"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "inventory.runtime"
            },
            "value_type": "string"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "coverage",
              "kind": "claim_value",
              "predicate": "security.coverage.source"
            },
            "operator": "eq",
            "right": {
              "kind": "parameter",
              "parameter": "scope"
            },
            "value_type": "string"
          }
        ],
        "kind": "all_of"
      }
    }
  ]
}
