{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "description": "Every workflow read from one source (host/owner/repo@ref) and its jobs, with each many-valued fact's Claims: the repo parse's tap. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "workflow",
    "subject_kinds": [
      "security.workflow"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.source_facts"
  },
  "includes": [
    {
      "binding": "included_needs",
      "direction": "forward",
      "from_binding": "job",
      "many": true,
      "max_items": 500,
      "name": "needs",
      "predicate": "security.job.needs"
    },
    {
      "binding": "included_permission",
      "direction": "forward",
      "from_binding": "job",
      "many": true,
      "max_items": 500,
      "name": "permission",
      "predicate": "security.job.permission"
    },
    {
      "binding": "included_publishes_to",
      "direction": "forward",
      "from_binding": "job",
      "many": true,
      "max_items": 500,
      "name": "publishes_to",
      "predicate": "security.job.publishes_to"
    },
    {
      "binding": "included_secret",
      "direction": "forward",
      "from_binding": "job",
      "many": true,
      "max_items": 500,
      "name": "secret",
      "predicate": "security.job.secret"
    },
    {
      "binding": "included_trigger",
      "direction": "forward",
      "from_binding": "workflow",
      "many": true,
      "max_items": 500,
      "name": "trigger",
      "predicate": "security.workflow.trigger"
    },
    {
      "binding": "included_uses",
      "direction": "forward",
      "from_binding": "job",
      "many": true,
      "max_items": 500,
      "name": "uses",
      "predicate": "security.job.uses"
    }
  ],
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "source",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "coverage",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.coverage"
        }
      },
      {
        "name": "environment",
        "value": {
          "binding": "job",
          "kind": "claim_value",
          "predicate": "security.job.environment"
        }
      },
      {
        "name": "job",
        "value": {
          "binding": "job",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "job_key",
        "value": {
          "binding": "job",
          "kind": "claim_value",
          "predicate": "security.job.job_key"
        }
      },
      {
        "name": "path",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.path"
        }
      },
      {
        "name": "repo",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.repo"
        }
      },
      {
        "name": "workflow",
        "value": {
          "binding": "workflow",
          "field": "subject_id",
          "kind": "subject_field"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "job",
      "direction": "reverse",
      "from_binding": "workflow",
      "predicate": "security.job.workflow",
      "required": false,
      "target_subject_kinds": [
        "security.job"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "workflow",
      "kind": "claim_value",
      "predicate": "security.workflow.source"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "source"
    },
    "value_type": "string"
  }
}
