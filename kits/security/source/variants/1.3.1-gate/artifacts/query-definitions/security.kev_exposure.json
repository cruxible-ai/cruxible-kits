{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 500,
    "max_traversal_depth": 10
  },
  "description": "Internet-facing assets with a release assessed affected by a KEV-listed vulnerability. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "asset",
    "subject_kinds": [
      "security.asset"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.kev_exposure"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "assessment",
        "value": {
          "binding": "assessment",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "criticality",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.criticality"
        }
      },
      {
        "name": "kev_due_date",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_due_date"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "service",
        "value": {
          "binding": "service",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "status",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "team",
        "value": {
          "binding": "team",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "vulnerability",
        "value": {
          "binding": "vulnerability",
          "field": "subject_id",
          "kind": "subject_field"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.installs",
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "assessment",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.assessment.release",
      "target_subject_kinds": [
        "security.assessment"
      ]
    },
    {
      "binding": "vulnerability",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.vulnerability",
      "target_subject_kinds": [
        "security.vulnerability"
      ]
    },
    {
      "binding": "service",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.serves",
      "required": false,
      "target_subject_kinds": [
        "security.service"
      ]
    },
    {
      "binding": "team",
      "direction": "forward",
      "from_binding": "service",
      "predicate": "security.service.owned_by",
      "required": false,
      "target_subject_kinds": [
        "security.team"
      ]
    }
  ],
  "where": {
    "filters": [
      {
        "kind": "comparison",
        "left": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.status"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "affected"
        },
        "value_type": "string"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.internet_exposed"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": true
        },
        "value_type": "boolean"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_listed"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": true
        },
        "value_type": "boolean"
      }
    ],
    "kind": "all_of"
  }
}
