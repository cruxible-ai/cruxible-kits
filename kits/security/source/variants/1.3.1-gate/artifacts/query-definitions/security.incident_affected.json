          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "window_start",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.window_start"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "vulnerability",
      "direction": "forward",
      "from_binding": "incident",
      "predicate": "security.incident.vulnerability",
      "target_subject_kinds": [
        "security.vulnerability"
      ]
    },
    {
      "binding": "assessment",
      "direction": "reverse",
      "from_binding": "vulnerability",
      "predicate": "security.assessment.vulnerability",
      "target_subject_kinds": [
        "security.assessment"
      ],
      "where": {
        "filters": [
          {
            "kind": "comparison",
            "left": {
              "binding": "assessment",
              "kind": "claim_value",
              "predicate": "security.assessment.status"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "affected"
            },
            "value_type": "string"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "assessment",
              "kind": "claim_value",
              "predicate": "security.assessment.status"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "inconclusive"
            },
            "value_type": "string"
          }
        ],
        "kind": "any_of"
      }
    },
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.release",
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "asset",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.asset.runs",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "coverage",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.scanned_in",
      "required": false,
      "target_subject_kinds": [
        "security.coverage"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "inventory.runtime"
        },
        "value_type": "string"
      }
    },
    {
      "binding": "service",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.serves",
      "required": false,
      "target_subject_kinds": [
        "security.service"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "incident",
      "kind": "claim_value",
      "predicate": "security.incident.name"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "incident"
    },
    "value_type": "string"
  }
}
