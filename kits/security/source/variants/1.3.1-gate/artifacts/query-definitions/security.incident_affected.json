          "kind": "subject_field"
        }
      },
      {
        "name": "rotation_policy",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.rotation_policy"
        }
      },
      {
        "name": "service",
        "value": {
          "binding": "service",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "service_name",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.name"
        }
      },
      {
        "name": "status",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.status"
