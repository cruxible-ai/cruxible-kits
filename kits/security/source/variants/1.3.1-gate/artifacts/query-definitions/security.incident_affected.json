{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "RQ1's exposure for a reader (parameter incident, its name): each release assessed affected or inconclusive for one of the incident's CVEs, affected first, with the assets a scan observed running it, their coverage and services; the not_affected rows are security.incident_exposure's. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "incident",
    "subject_kinds": [
      "security.incident"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.incident_affected"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "orderings": [
    {
      "key": {
        "binding": "assessment",
        "kind": "claim_value",
        "predicate": "security.assessment.status"
      },
      "value_type": "string"
    },
    {
      "direction": "descending",
      "key": {
        "binding": "asset",
        "kind": "claim_value",
        "predicate": "security.asset.internet_exposed"
      },
      "value_type": "boolean"
    }
  ],
  "parameters": [
    {
      "name": "incident",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "assessment",
        "value": {
          "binding": "assessment",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "components",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.component"
        }
      },
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage_revision",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "cve_id",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.cve_id"
        }
      },
      {
        "name": "hostname",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "incident",
        "value": {
          "binding": "incident",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "incident_status",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.status"
        }
      },
      {
        "name": "internet_exposed",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.internet_exposed"
        }
      },
      {
        "name": "looked_for",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.looked_for"
