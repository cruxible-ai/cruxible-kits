{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "RQ1 for one incident (parameter incident): each CVE with its record's title, named products and OSV packages, every release assessed for one (any status, with the components the answer rests on), affected first, and every asset a scan observed running it with its coverage and services (security.incident_affected: affected and inconclusive only). Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "incident",
    "subject_kinds": [
      "security.incident"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.incident_exposure"
  },
  "includes": [
    {
      "binding": "included_assessed_component",
      "direction": "forward",
      "from_binding": "assessment",
      "many": true,
      "max_items": 500,
      "name": "assessed_component",
      "predicate": "security.assessment.component"
    },
    {
      "binding": "included_package",
      "direction": "forward",
      "from_binding": "vulnerability",
      "many": true,
      "max_items": 500,
      "name": "package",
      "predicate": "security.vulnerability.package"
    }
  ],
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "orderings": [
    {
      "key": {
        "binding": "assessment",
        "kind": "claim_value",
        "predicate": "security.assessment.status"
      },
      "value_type": "string"
    }
  ],
  "parameters": [
    {
      "name": "incident",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "assessment",
        "value": {
          "binding": "assessment",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "components",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.component"
        }
      },
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage_revision",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "cve_id",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.cve_id"
        }
      },
      {
        "name": "cve_packages",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.package"
        }
      },
      {
        "name": "cve_products",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.affected_product"
        }
      },
      {
        "name": "cve_title",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.title"
        }
      },
      {
        "name": "hostname",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "incident",
        "value": {
          "binding": "incident",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "incident_status",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.status"
        }
      },
      {
        "name": "internet_exposed",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.internet_exposed"
        }
      },
      {
        "name": "looked_for",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.looked_for"
        }
      },
      {
        "name": "product_name",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "rotation_policy",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.rotation_policy"
        }
      },
      {
        "name": "service",
        "value": {
          "binding": "service",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "service_log_source",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.log_source"
        }
      },
      {
        "name": "service_name",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.name"
        }
      },
      {
        "name": "status",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "status_role",
        "value": {
          "binding": "assessment",
          "field": "role",
          "kind": "claim_field",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "version",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "window_start",
        "value": {
          "binding": "incident",
          "kind": "claim_value",
          "predicate": "security.incident.window_start"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "vulnerability",
      "direction": "forward",
      "from_binding": "incident",
      "predicate": "security.incident.vulnerability",
      "required": false,
      "target_subject_kinds": [
        "security.vulnerability"
      ]
    },
    {
      "binding": "assessment",
      "direction": "reverse",
      "from_binding": "vulnerability",
      "predicate": "security.assessment.vulnerability",
      "required": false,
      "target_subject_kinds": [
        "security.assessment"
      ]
    },
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.release",
      "required": false,
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "asset",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.asset.runs",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "coverage",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.scanned_in",
      "required": false,
      "target_subject_kinds": [
        "security.coverage"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "inventory.runtime"
        },
        "value_type": "string"
      }
    },
    {
      "binding": "service",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.serves",
      "required": false,
      "target_subject_kinds": [
        "security.service"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "incident",
      "kind": "claim_value",
      "predicate": "security.incident.name"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "incident"
    },
    "value_type": "string"
  }
}
