{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "HQ6: every confirmed finding not verified fixed that affects a release a gated target serves a file of, with the target, the artifact and the release. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "target",
    "subject_kinds": [
      "security.target"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.published_findings"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "artifact",
        "value": {
          "binding": "artifact",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "artifact_name",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.name"
        }
      },
      {
        "name": "finding",
        "value": {
          "binding": "finding",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "gate",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.publish_gate"
        }
      },
      {
        "name": "locus",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.locus"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "release_version",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "severity",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.severity"
        }
      },
      {
        "name": "target",
        "value": {
          "binding": "target",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "target_name",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.name"
        }
      },
      {
        "name": "target_registry",
        "value": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.registry"
        }
      },
      {
        "name": "verdict",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.verdict"
        }
      },
      {
        "name": "verification",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.verification"
        }
      },
      {
        "name": "weakness",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.weakness"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "artifact",
      "direction": "reverse",
      "from_binding": "target",
      "predicate": "security.artifact.target",
      "target_subject_kinds": [
        "security.artifact"
      ]
    },
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "artifact",
      "predicate": "security.artifact.release",
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "finding",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.finding.affects",
      "target_subject_kinds": [
        "security.finding"
      ],
      "where": {
        "filters": [
          {
            "filters": [
              {
                "binding": "finding",
                "kind": "claim_presence",
                "negated": true,
                "predicate": "security.finding.verification"
              },
              {
                "kind": "comparison",
                "left": {
                  "binding": "finding",
                  "kind": "claim_value",
                  "predicate": "security.finding.verification"
                },
                "operator": "ne",
                "right": {
                  "kind": "literal",
                  "value": "fixed"
                },
                "value_type": "string"
              }
            ],
            "kind": "any_of"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "finding",
              "kind": "claim_value",
              "predicate": "security.finding.verdict"
            },
            "operator": "eq",
            "right": {
              "kind": "literal",
              "value": "confirmed"
            },
            "value_type": "string"
          }
        ],
        "kind": "all_of"
      }
    }
  ],
  "where": {
    "binding": "target",
    "kind": "claim_presence",
    "predicate": "security.target.publish_gate"
  }
}
