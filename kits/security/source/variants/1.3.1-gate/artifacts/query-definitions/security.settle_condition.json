{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "subject",
  "default_budgets": {
    "max_results": 1,
    "max_traversal_depth": 1
  },
  "description": "One vulnerability by id with its CVE key; the condition the KEV and EPSS triage settle mandates evaluate per changed Claim (triage only changes watched ones).",
  "entry": {
    "binding": "vulnerability",
    "subject_id": {
      "kind": "parameter",
      "parameter": "vulnerability_id"
    },
    "subject_kinds": [
      "security.vulnerability"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.settle_condition"
  },
  "maximum_budgets": {
    "max_results": 10,
    "max_traversal_depth": 1
  },
  "parameters": [
    {
      "name": "vulnerability_id",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "cve_id",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.cve_id"
        }
      },
      {
        "name": "vulnerability",
        "value": {
          "binding": "vulnerability",
          "field": "subject_id",
          "kind": "subject_field"
        }
      }
    ]
  },
  "result_shape": "subject"
}
