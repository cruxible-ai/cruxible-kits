{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "Every patch (a remediation with work.asset and work.assessment) of an asset scanned in one inventory scope, with its progress, verification and the release it moves the asset off: the import's verification tap. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "coverage",
    "subject_kinds": [
      "security.coverage"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current",
      "stale"
    ],
    "visible_verdicts": [
      "stale",
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.inventory_patches"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "scope",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "affected",
        "value": {
          "binding": "affected",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "affected_product",
        "value": {
          "binding": "affected",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "affected_version",
        "value": {
          "binding": "affected",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "cve_id",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.cve_id"
        }
      },
      {
        "name": "hostname",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.hostname"
        }
      },
      {
        "name": "patch",
        "value": {
          "binding": "patch",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "progress",
        "value": {
          "binding": "patch",
          "kind": "claim_value",
          "predicate": "security.remediation.progress"
        }
      },
      {
        "name": "verification",
        "value": {
          "binding": "patch",
          "kind": "claim_value",
          "predicate": "security.work.verification"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "asset",
      "direction": "reverse",
      "from_binding": "coverage",
      "predicate": "security.asset.scanned_in",
      "target_subject_kinds": [
        "security.asset"
      ]
    },
    {
      "binding": "patch",
      "direction": "reverse",
      "from_binding": "asset",
      "predicate": "security.work.asset",
      "target_subject_kinds": [
        "security.remediation"
      ]
    },
    {
      "binding": "assessment",
      "direction": "forward",
      "from_binding": "patch",
      "predicate": "security.work.assessment",
      "target_subject_kinds": [
        "security.assessment"
      ]
    },
    {
      "binding": "affected",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.release",
      "target_subject_kinds": [
        "security.release"
      ]
    }
  ],
  "where": {
    "filters": [
      {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "literal",
          "value": "inventory.runtime"
        },
        "value_type": "string"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.source"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "scope"
        },
        "value_type": "string"
      }
    ],
    "kind": "all_of"
  }
}
