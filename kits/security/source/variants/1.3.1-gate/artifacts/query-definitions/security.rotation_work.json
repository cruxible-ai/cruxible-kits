{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "Every credential with its current key state and every rotation of it, with the window its incident opened: the credential import's tap. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "credential",
    "subject_kinds": [
      "security.credential"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.rotation_work"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "credential",
        "value": {
          "binding": "credential",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "issued_at",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.issued_at"
        }
      },
      {
        "name": "issued_by",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.issued_by"
        }
      },
      {
        "name": "issuer",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.issuer"
        }
      },
      {
        "name": "key_id",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.key_id"
        }
      },
      {
        "name": "name",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.name"
        }
      },
      {
        "name": "progress",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.remediation.progress"
        }
      },
      {
        "name": "revoked_key",
        "value": {
          "binding": "credential",
          "kind": "claim_value",
          "predicate": "security.credential.revoked_key"
        }
      },
      {
        "name": "revokes_key",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.remediation.revokes_key"
        }
      },
      {
        "name": "rotation",
        "value": {
          "binding": "rotation",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "verification",
        "value": {
          "binding": "rotation",
          "kind": "claim_value",
          "predicate": "security.work.verification"
        }
      },
      {
        "name": "window_start",
        "value": {
          "binding": "rotation_incident",
          "kind": "claim_value",
          "predicate": "security.incident.window_start"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "rotation",
      "direction": "reverse",
      "from_binding": "credential",
      "predicate": "security.work.credential",
      "required": false,
      "target_subject_kinds": [
        "security.remediation"
      ]
    },
    {
      "binding": "rotation_audit",
      "direction": "forward",
      "from_binding": "rotation",
      "predicate": "security.work.audit",
      "required": false,
      "target_subject_kinds": [
        "security.audit"
      ]
    },
    {
      "binding": "rotation_incident",
      "direction": "forward",
      "from_binding": "rotation_audit",
      "predicate": "security.audit.incident",
      "required": false,
      "target_subject_kinds": [
        "security.incident"
      ]
    }
  ]
}
