{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "subject",
  "description": "Findings with a fix commit (fixed_by) that no full scan or passing PoC has verified fixed yet. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "finding",
    "subject_kinds": [
      "security.finding"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.unverified_fixes"
  },
  "maximum_budgets": {
    "max_results": 2000,
    "max_traversal_depth": 1
  },
  "projection": {
    "fields": [
      {
        "name": "finding",
        "value": {
          "binding": "finding",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "fixed_by",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.fixed_by"
        }
      },
      {
        "name": "locus",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.locus"
        }
      },
      {
        "name": "repo_ref",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.repo_ref"
        }
      },
      {
        "name": "verdict",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.verdict"
        }
      },
      {
        "name": "verification",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.verification"
        }
      },
      {
        "name": "weakness",
        "value": {
          "binding": "finding",
          "kind": "claim_value",
          "predicate": "security.finding.weakness"
        }
      }
    ]
  },
  "result_shape": "subject",
  "where": {
    "filters": [
      {
        "binding": "finding",
        "kind": "claim_presence",
        "predicate": "security.finding.fixed_by"
      },
      {
        "filters": [
          {
            "binding": "finding",
            "kind": "claim_presence",
            "negated": true,
            "predicate": "security.finding.verification"
          },
          {
            "kind": "comparison",
            "left": {
              "binding": "finding",
              "kind": "claim_value",
              "predicate": "security.finding.verification"
            },
            "operator": "ne",
            "right": {
              "kind": "literal",
              "value": "fixed"
            },
            "value_type": "string"
          }
        ],
        "kind": "any_of"
      }
    ],
    "kind": "all_of"
  }
}
