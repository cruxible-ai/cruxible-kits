{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "description": "Every release with its product, supplier, components, OSV coverage and product aliases. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "release",
    "subject_kinds": [
      "security.release"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.release_inventory"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "components",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.component"
        }
      },
      {
        "name": "osv_coverage",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.osv_coverage"
        }
      },
      {
        "name": "product",
        "value": {
          "binding": "product",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "product_alias",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.product_alias"
        }
      },
      {
        "name": "product_name",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.product_name"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "supplier",
        "value": {
          "binding": "supplier",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "supplier_name",
        "value": {
          "binding": "supplier",
          "kind": "claim_value",
          "predicate": "security.supplier.name"
        }
      },
      {
        "name": "unidentified",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.unidentified_components"
        }
      },
      {
        "name": "version",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "product",
      "direction": "forward",
      "from_binding": "release",
      "predicate": "security.release.product",
      "required": false,
      "target_subject_kinds": [
        "security.product"
      ]
    },
    {
      "binding": "supplier",
      "direction": "forward",
      "from_binding": "product",
      "predicate": "security.product.supplied_by",
      "required": false,
      "target_subject_kinds": [
        "security.supplier"
      ]
    }
  ]
}
