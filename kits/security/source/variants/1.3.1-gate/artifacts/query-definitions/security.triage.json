{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 200,
    "max_traversal_depth": 10
  },
  "description": "Applicability, exposure, KEV and EPSS facts for one vulnerability, per host that declares installing a release (asset_observed is set when a scan also observed it running there; hosts only a scan sees are in security.urgent_exposures and an incident's RQ1). Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "asset",
    "subject_kinds": [
      "security.asset"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.triage"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "vulnerability",
      "value_type": "subject_reference"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "assessment",
        "value": {
          "binding": "assessment",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "asset",
        "value": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "asset_observed",
        "value": {
          "binding": "asset_run",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "component",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.component"
        }
      },
      {
        "name": "criticality",
        "value": {
          "binding": "service",
          "kind": "claim_value",
          "predicate": "security.service.criticality"
        }
      },
      {
        "name": "epss_percentile",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.epss_percentile"
        }
      },
      {
        "name": "epss_score",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.epss_score"
        }
      },
      {
        "name": "internet_exposed",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "security.asset.internet_exposed"
        }
      },
      {
        "name": "justification",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.justification"
        }
      },
      {
        "name": "kev_due_date",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_due_date"
        }
      },
      {
        "name": "kev_listed",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_listed"
        }
      },
      {
        "name": "release",
        "value": {
          "binding": "release",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "service",
        "value": {
          "binding": "service",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "status",
        "value": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "status_role",
        "value": {
          "binding": "assessment",
          "field": "role",
          "kind": "claim_field",
          "predicate": "security.assessment.status"
        }
      },
      {
        "name": "team",
        "value": {
          "binding": "team",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "version",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "vulnerability",
        "value": {
          "binding": "vulnerability",
          "field": "subject_id",
          "kind": "subject_field"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.installs",
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "asset_run",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.asset.runs",
      "required": false,
      "target_subject_kinds": [
        "security.asset"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "asset_run",
          "field": "subject_id",
          "kind": "subject_field"
        },
        "operator": "eq",
        "right": {
          "binding": "asset",
          "field": "subject_id",
          "kind": "subject_field"
        },
        "value_type": "string"
      }
    },
    {
      "binding": "assessment",
      "direction": "reverse",
      "from_binding": "release",
      "predicate": "security.assessment.release",
      "required": false,
      "target_subject_kinds": [
        "security.assessment"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "assessment",
          "kind": "claim_value",
          "predicate": "security.assessment.vulnerability"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "vulnerability"
        },
        "value_type": "subject_reference"
      }
    },
    {
      "binding": "vulnerability",
      "direction": "forward",
      "from_binding": "assessment",
      "predicate": "security.assessment.vulnerability",
      "required": false,
      "target_subject_kinds": [
        "security.vulnerability"
      ]
    },
    {
      "binding": "service",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "security.asset.serves",
      "required": false,
      "target_subject_kinds": [
        "security.service"
      ]
    },
    {
      "binding": "team",
      "direction": "forward",
      "from_binding": "service",
      "predicate": "security.service.owned_by",
      "required": false,
      "target_subject_kinds": [
        "security.team"
      ]
    }
  ]
}
