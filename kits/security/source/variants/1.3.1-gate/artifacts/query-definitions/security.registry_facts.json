{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "description": "One target (by registry and name) with every artifact it serves and what each was published by and built from: the parse Procedures' tap. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "target",
    "subject_kinds": [
      "security.target"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.registry_facts"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "name",
      "value_type": "string"
    },
    {
      "name": "registry",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "artifact",
        "value": {
          "binding": "artifact",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "artifact_name",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.name"
        }
      },
      {
        "name": "built_from_sha",
        "value": {
          "binding": "change",
          "kind": "claim_value",
          "predicate": "security.change.commit_sha"
        }
      },
      {
        "name": "declared_sha256",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.declared_sha256"
        }
      },
      {
        "name": "publish_environment",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.publish_environment"
        }
      },
      {
        "name": "release_version",
        "value": {
          "binding": "release",
          "kind": "claim_value",
          "predicate": "security.release.version"
        }
      },
      {
        "name": "repo_full_name",
        "value": {
          "binding": "repo",
          "kind": "claim_value",
          "predicate": "security.repo.full_name"
        }
      },
      {
        "name": "sha256",
        "value": {
          "binding": "artifact",
          "kind": "claim_value",
          "predicate": "security.artifact.sha256"
        }
      },
      {
        "name": "target",
        "value": {
          "binding": "target",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "workflow_path",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.path"
        }
      },
      {
        "name": "workflow_source",
        "value": {
          "binding": "workflow",
          "kind": "claim_value",
          "predicate": "security.workflow.source"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "artifact",
      "direction": "reverse",
      "from_binding": "target",
      "predicate": "security.artifact.target",
      "required": false,
      "target_subject_kinds": [
        "security.artifact"
      ]
    },
    {
      "binding": "workflow",
      "direction": "forward",
      "from_binding": "artifact",
      "predicate": "security.artifact.published_by",
      "required": false,
      "target_subject_kinds": [
        "security.workflow"
      ]
    },
    {
      "binding": "change",
      "direction": "forward",
      "from_binding": "artifact",
      "predicate": "security.artifact.built_from",
      "required": false,
      "target_subject_kinds": [
        "security.change"
      ]
    },
    {
      "binding": "release",
      "direction": "forward",
      "from_binding": "artifact",
      "predicate": "security.artifact.release",
      "required": false,
      "target_subject_kinds": [
        "security.release"
      ]
    },
    {
      "binding": "repo",
      "direction": "forward",
      "from_binding": "target",
      "predicate": "security.target.source_repo",
      "required": false,
      "target_subject_kinds": [
        "security.repo"
      ]
    }
  ],
  "where": {
    "filters": [
      {
        "kind": "comparison",
        "left": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.name"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "name"
        },
        "value_type": "string"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "target",
          "kind": "claim_value",
          "predicate": "security.target.registry"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "registry"
        },
        "value_type": "string"
      }
    ],
    "kind": "all_of"
  }
}
