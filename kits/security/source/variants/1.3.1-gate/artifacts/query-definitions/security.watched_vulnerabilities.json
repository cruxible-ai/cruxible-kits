{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "description": "Every watched vulnerability (a watch_reason, an affected or inconclusive assessment of a release in inventory, or an incident responding to it) with its current KEV and EPSS Claims, its record's title and the packages OSV says it affects. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "vulnerability",
    "subject_kinds": [
      "security.vulnerability"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.watched_vulnerabilities"
  },
  "includes": [
    {
      "binding": "included_affected_product",
      "direction": "forward",
      "from_binding": "vulnerability",
      "many": true,
      "max_items": 500,
      "name": "affected_product",
      "predicate": "security.vulnerability.affected_product"
    },
    {
      "binding": "included_package",
      "direction": "forward",
      "from_binding": "vulnerability",
      "many": true,
      "max_items": 500,
      "name": "package",
      "predicate": "security.vulnerability.package"
    }
  ],
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "cve_id",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.cve_id"
        }
      },
      {
        "name": "epss_percentile",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.epss_percentile"
        }
      },
      {
        "name": "epss_score",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.epss_score"
        }
      },
      {
        "name": "kev_date_added",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_date_added"
        }
      },
      {
        "name": "kev_due_date",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_due_date"
        }
      },
      {
        "name": "kev_listed",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_listed"
        }
      },
      {
        "name": "kev_ransomware_use",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.kev_ransomware_use"
        }
      },
      {
        "name": "title",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.title"
        }
      },
      {
        "name": "vulnerability",
        "value": {
          "binding": "vulnerability",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "watch_reason",
        "value": {
          "binding": "vulnerability",
          "kind": "claim_value",
          "predicate": "security.vulnerability.watch_reason"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "assessment",
      "direction": "reverse",
      "from_binding": "vulnerability",
      "predicate": "security.assessment.vulnerability",
      "required": false,
      "target_subject_kinds": [
        "security.assessment"
      ]
    },
    {
      "binding": "incident",
      "direction": "reverse",
      "from_binding": "vulnerability",
      "predicate": "security.incident.vulnerability",
      "required": false,
      "target_subject_kinds": [
        "security.incident"
      ]
    }
  ],
  "where": {
    "filters": [
      {
        "binding": "incident",
        "kind": "claim_presence",
        "predicate": "security.incident.name"
      },
      {
        "binding": "vulnerability",
        "kind": "claim_presence",
        "predicate": "security.vulnerability.watch_reason"
      },
      {
        "filters": [
          {
            "binding": "assessment",
            "kind": "claim_presence",
            "predicate": "security.assessment.release"
          },
          {
            "filters": [
              {
                "kind": "comparison",
                "left": {
                  "binding": "assessment",
                  "kind": "claim_value",
                  "predicate": "security.assessment.status"
                },
                "operator": "eq",
                "right": {
                  "kind": "literal",
                  "value": "affected"
                },
                "value_type": "string"
              },
              {
                "kind": "comparison",
                "left": {
                  "binding": "assessment",
                  "kind": "claim_value",
                  "predicate": "security.assessment.status"
                },
                "operator": "eq",
                "right": {
                  "kind": "literal",
                  "value": "inconclusive"
                },
                "value_type": "string"
              }
            ],
            "kind": "any_of"
          }
        ],
        "kind": "all_of"
      }
    ],
    "kind": "any_of"
  }
}
