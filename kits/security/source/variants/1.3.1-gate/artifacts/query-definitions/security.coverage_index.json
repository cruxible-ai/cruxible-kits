{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "subject",
  "default_budgets": {
    "max_results": 10,
    "max_traversal_depth": 1
  },
  "description": "One source's coverage (source, scope) with the revision it was read at and what it belongs to, stale or current: the parse Procedures' tap. Scoped to supported, current Claims; missing evidence is not a negative finding.",
  "entry": {
    "binding": "coverage",
    "subject_kinds": [
      "security.coverage"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current",
      "stale"
    ],
    "visible_verdicts": [
      "stale",
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "security.coverage_index"
  },
  "maximum_budgets": {
    "max_results": 2000,
    "max_traversal_depth": 1
  },
  "parameters": [
    {
      "name": "scope",
      "value_type": "string"
    },
    {
      "name": "source",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "coverage",
        "value": {
          "binding": "coverage",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "of",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.of"
        }
      },
      {
        "name": "revision",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.revision"
        }
      },
      {
        "name": "scope",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        }
      },
      {
        "name": "source",
        "value": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.source"
        }
      }
    ]
  },
  "result_shape": "subject",
  "where": {
    "filters": [
      {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.scope"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "scope"
        },
        "value_type": "string"
      },
      {
        "kind": "comparison",
        "left": {
          "binding": "coverage",
          "kind": "claim_value",
          "predicate": "security.coverage.source"
        },
        "operator": "eq",
        "right": {
          "kind": "parameter",
          "parameter": "source"
        },
        "value_type": "string"
      }
    ],
    "kind": "all_of"
  }
}
