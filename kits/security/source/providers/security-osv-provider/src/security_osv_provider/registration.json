{
  "schema_version": 3,
  "manifest": {
    "path": "manifest.yaml",
    "digest": "sha256:63652162e21dd710623be0370112af8899fed10c44bee1e31f6cb4e79365a835"
  },
  "operations": [
    {
      "name": "osv.match",
      "description": "Matches this run's OSV responses to the components asked about: one document of (component, CVE) pairs with the advisory and the versions OSV lists as fixed, the components answered in full, and those left unchecked with why.",
      "source": {
        "path": "kits/security/source/providers/security-osv-provider/src/security_osv_provider/osv.py",
        "repository": "https://github.com/cruxible-ai/cruxible-kits"
      },
      "serves": [
        "security.osv.match"
      ],
      "in": "security.osv.match.request@1",
      "out": "security.osv.match.result@1",
      "effect": "pure",
      "refusals": {
        "provider_declined": {
          "contract": "osv.match.refusal.provider_declined@1",
          "absorbable": false
        }
      },
      "entrypoint": "security_osv_provider.osv:osv_match"
    },
    {
      "name": "osv.query",
      "description": "Asks api.osv.dev about each component (one POST /v1/querybatch per 1000, then GET /v1/vulns/{id} for every advisory named), a distro package by the OSV source package its SBOM states, and returns every response as canonical JSON, one Capture each; a distro package with none is never asked.",
      "source": {
        "path": "kits/security/source/providers/security-osv-provider/src/security_osv_provider/osv.py",
        "repository": "https://github.com/cruxible-ai/cruxible-kits"
      },
      "serves": [
        "security.osv.query"
      ],
      "in": "security.osv.query.request@2",
      "out": "security.osv.query.result@1",
      "effect": "external_read",
      "refusals": {
        "provider_declined": {
          "contract": "osv.query.refusal.provider_declined@1",
          "absorbable": false
        }
      },
      "entrypoint": "security_osv_provider.osv:OsvQuery"
    },
    {
      "name": "sbom.components",
      "description": "Reads one CycloneDX or SPDX 2.x JSON SBOM: one document naming its inventory and each distinct component by purl with its scope, nested components flattened, unidentified ones counted, distro packages with the OSV source package they are asked as.",
      "source": {
        "path": "kits/security/source/providers/security-osv-provider/src/security_osv_provider/sbom.py",
        "repository": "https://github.com/cruxible-ai/cruxible-kits"
      },
      "serves": [
        "security.sbom.components"
      ],
      "in": "security.sbom.components.request@1",
      "out": "security.sbom.components.result@1",
      "effect": "pure",
      "refusals": {
        "provider_declined": {
          "contract": "sbom.components.refusal.provider_declined@1",
          "absorbable": false
        }
      },
      "entrypoint": "security_osv_provider.sbom:sbom_components"
    }
  ],
  "declares": {
    "contracts": [
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "osv.match.refusal.provider_declined",
        "version": 1,
        "description": "Detail of a provider_declined refusal (too many advisories, or unreadable input).",
        "fields": {}
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "osv.query.refusal.provider_declined",
        "version": 1,
        "description": "Detail of a provider_declined refusal (too many advisories, or unreadable input).",
        "fields": {}
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "sbom.components.refusal.provider_declined",
        "version": 1,
        "description": "Detail of a provider_declined refusal (the bytes are not a CycloneDX JSON SBOM, or list too many components).",
        "fields": {}
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.osv-affected",
        "version": 2,
        "description": "One (component, CVE) pair the OSV match found: its OSV advisory id and the versions OSV lists as fixed for the component's package, as one line ('none listed' when there are none). They are no Claim: the affected_by Claim's reason carries them, and the cited document holds the full list.",
        "fields": {
          "fixed_versions": {
            "type": {
              "kind": "string",
              "max_len": 240,
              "min_len": 1
            }
          },
          "osv_id": {
            "type": {
              "kind": "string",
              "max_len": 128
            }
          }
        },
        "predecessor_digest": "sha256:435d69a8bd74b0a7d2d4bb5c4b31a593ba7c8d6908dce07f5bad4c55c340222d"
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.osv-not-checked",
        "version": 1,
        "description": "One component the OSV match left unchecked, and why: a distro package whose source name OSV cannot be asked by, a component with no version, a batch that failed or was truncated, an advisory that could not be read, or a component never asked.",
        "fields": {
          "reason": {
            "type": {
              "kind": "enum",
              "members": [
                "advisory_unreadable",
                "batch_failed",
                "distro_source_name_unknown",
                "no_version",
                "not_asked",
                "truncated"
              ]
            }
          }
        }
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.osv-unkeyed-record",
        "version": 1,
        "description": "One OSV advisory with no CVE alias that lists a component: the component's purl and the advisory id.",
        "fields": {
          "osv_id": {
            "type": {
              "kind": "string",
              "max_len": 128
            }
          },
          "purl": {
            "type": {
              "kind": "string",
              "max_len": 256
            }
          }
        }
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.osv-unkeyed-summary",
        "version": 1,
        "description": "The OSV advisories with no CVE alias in one match document, summarised: how many (advisory, component) pairs, the first 20 in component then advisory order, and the digest of the whole set.",
        "fields": {
          "count": {
            "type": {
              "kind": "int",
              "max": 1000000,
              "min": 1
            }
          },
          "sample": {
            "type": {
              "item": {
                "contract": {
                  "digest": "sha256:ccc29fb90ceb6aa73a0b87774e699ad5453683f577865ab0f9cc1910aeb8e81b",
                  "name": "security.osv-unkeyed-record",
                  "version": 1
                },
                "kind": "contract"
              },
              "kind": "list",
              "max_items": 20
            }
          },
          "set_digest": {
            "type": {
              "kind": "string",
              "max_len": 80
            }
          }
        }
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.osv.match.request",
        "version": 1,
        "description": "This run's OSV responses (their Capture bytes, passed by core), the components the run asked about, and the logical source the derived document is stated under.",
        "fields": {
          "components": {
            "type": {
              "item": {
                "kind": "string",
                "max_len": 256
              },
              "kind": "list",
              "max_items": 20000
            }
          },
          "logical_source": {
            "type": {
              "kind": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,255}$"
            }
          },
          "responses": {
            "type": {
              "item": {
                "capture_kind": "security.osv-response",
                "kind": "capture"
              },
              "kind": "list",
              "max_items": 1020
            }
          }
        }
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.osv.match.result",
        "version": 1,
        "description": "One derived JSON document of (component, CVE) matches, in the layout of CaptureKind security.osv-matches: queried (the components OSV answered in full), not_checked (each with why), affected (purl, cve_id, osv_id, and the versions OSV lists as fixed), count, and unkeyed (advisories with no CVE alias).",
        "fields": {
          "document": {
            "type": {
              "capture_kind": "security.osv-matches",
              "kind": "capture"
            }
          }
        }
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.osv.query.request",
        "version": 2,
        "description": "The components to ask OSV about, as purl@version, the logical source the responses are stated under, and the distro packages (purl types deb, rpm, apk) the SBOM import resolved to an OSV source package. A distro component is asked by that package (ecosystem, source name, version); one without it is never asked, never in queried, and reads not checked.",
        "fields": {
          "components": {
            "type": {
              "item": {
                "kind": "string",
                "max_len": 256
              },
              "kind": "list",
              "max_items": 20000
            }
          },
          "distro_packages": {
            "description": "ECOSYSTEM|NAME|VERSION for each distro_purls entry (security.occurrence.osv_package). A purl given two different packages is never asked.",
            "optional": true,
            "type": {
              "item": {
                "kind": "string",
                "max_len": 256
              },
              "kind": "list",
              "max_items": 20000
            }
          },
          "distro_purls": {
            "description": "The distro components that have an OSV package, one per distro_packages entry, in the same order.",
            "optional": true,
            "type": {
              "item": {
                "kind": "string",
                "max_len": 256
              },
              "kind": "list",
              "max_items": 20000
            }
          },
          "logical_source": {
            "type": {
              "kind": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,255}$"
            }
          }
        },
        "predecessor_digest": "sha256:dc317950f92ce175d69ca0c30ff013d11c89aac8ea5087a6470f52ae508416da"
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.osv.query.result",
        "version": 1,
        "description": "OSV's responses as canonical JSON (sorted keys, no spaces; a body that is not JSON stays verbatim), one Capture each: every POST /v1/querybatch (at most 1000 components) and every GET /v1/vulns/{id} a batch names. A request that got no response at all is left out and the call is marked incomplete; a response with an error status is still a member.",
        "fields": {
          "responses": {
            "type": {
              "item": {
                "capture_kind": "security.osv-response",
                "kind": "capture"
              },
              "kind": "list",
              "max_items": 1020
            }
          }
        }
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.sbom-component",
        "version": 2,
        "description": "One component an SBOM lists, with its scope, and for a distro package (deb, rpm, apk) the OSV package it is asked as when the SBOM states its release and source package.",
        "fields": {
          "name": {
            "optional": true,
            "type": {
              "kind": "string",
              "max_len": 256
            }
          },
          "named_by": {
            "type": {
              "kind": "enum",
              "members": [
                "metadata_component",
                "file_path"
              ]
            }
          },
          "osv_package": {
            "description": "ECOSYSTEM|NAME|VERSION: the OSV ecosystem (Debian:12, Alpine:v3.19, Red Hat, ...), the source package and its version; absent for a non-distro component or one whose release or source the SBOM does not state.",
            "optional": true,
            "type": {
              "kind": "string",
              "max_len": 256,
              "min_len": 5
            }
          },
          "scope": {
            "type": {
              "claim_type": "security.occurrence.scope",
              "kind": "enum_of"
            }
          },
          "warning": {
            "optional": true,
            "type": {
              "kind": "enum",
              "members": [
                "sbom_unnamed"
              ]
            }
          }
        },
        "predecessor_digest": "sha256:04c4e110e39869026e7e4e74bbf4aca3bba92f21187c4783f544627872af67c6"
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.sbom.components.request",
        "version": 1,
        "description": "One CycloneDX JSON SBOM this run read (its Capture bytes, passed by core), its workspace path (the inventory's name when the SBOM has no metadata.component purl) and the logical source the derived document is stated under.",
        "fields": {
          "logical_source": {
            "type": {
              "kind": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,255}$"
            }
          },
          "relative_path": {
            "type": {
              "kind": "string",
              "max_len": 256
            }
          },
          "sbom": {
            "type": {
              "capture_kind": "security.cyclonedx-sbom",
              "kind": "capture"
            }
          }
        }
      },
      {
        "artifact_format": "cruxible-contract-v1",
        "name": "security.sbom.components.result",
        "version": 1,
        "description": "One derived JSON document in the layout of CaptureKind security.sbom-components: the inventory the SBOM describes, how it was named, and one record per distinct purl with its scope; count is every component the SBOM lists, unidentified ones included.",
        "fields": {
          "document": {
            "type": {
              "capture_kind": "security.sbom-components",
              "kind": "capture"
            }
          }
        }
      }
