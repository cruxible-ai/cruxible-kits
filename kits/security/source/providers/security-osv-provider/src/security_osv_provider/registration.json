                },
                "purl": {
                  "at": "purl",
                  "type": "key_part<security.component:purl>"
                }
              },
              "row": {
                "name": "security.osv-affected",
                "version": 1,
                "digest": "sha256:435d69a8bd74b0a7d2d4bb5c4b31a593ba7c8d6908dce07f5bad4c55c340222d"
              },
              "fields": {
                "osv_id": {
                  "at": "osv_id"
                }
              },
              "count_at": "/count"
            },
            "not_checked": {
              "at": "/not_checked/*",
              "key": {
                "purl": {
                  "at": "purl",
                  "type": "key_part<security.component:purl>"
                }
              },
              "row": {
                "name": "security.osv-not-checked",
                "version": 1,
                "digest": "sha256:547d75c18258a54d5c6f5de344c905efbf3e81b265a920dfb557ddf3d00fc963"
              },
              "fields": {
                "reason": {
                  "at": "reason"
                }
              }
            },
            "unkeyed": {
              "at": "/unkeyed/*",
              "row": {
                "name": "security.osv-unkeyed-record",
                "version": 1,
                "digest": "sha256:ccc29fb90ceb6aa73a0b87774e699ad5453683f577865ab0f9cc1910aeb8e81b"
              },
              "fields": {
                "osv_id": {
                  "at": "osv_id"
                },
                "purl": {
                  "at": "purl"
                }
              }
            },
            "unkeyed_summary": {
              "at": "/unkeyed_summary/*",
              "row": {
                "name": "security.osv-unkeyed-summary",
                "version": 1,
                "digest": "sha256:8b710318b5c25272bfb8d5019341bfc427cc08fe16756307a4a89c8fd05a1f83"
              },
              "fields": {
                "count": {
                  "at": "count"
                },
