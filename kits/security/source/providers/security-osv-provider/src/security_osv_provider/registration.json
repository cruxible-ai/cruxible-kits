                },
                "set_digest": {
                  "at": "set_digest"
                }
              }
            }
          }
        }
      },
      {
        "name": "security.osv-response",
        "decoding": {
          "format": "json",
          "encoding": "identity",
          "limits": {
            "decoded_bytes": 4194304,
            "depth": 32,
            "records": 100000
          }
        }
      },
      {
        "name": "security.sbom-components",
        "decoding": {
          "format": "json",
          "encoding": "identity",
          "limits": {
            "decoded_bytes": 4194304,
            "depth": 8,
            "records": 20000
          }
        },
        "layout": {
          "header": {
            "inventory": {
              "at": "/inventory",
              "type": "string{min_len: 1, max_len: 256}"
            }
          },
          "records": {
            "components": {
              "at": "/components/*",
              "key": {
                "purl": {
                  "at": "purl",
                  "type": "key_part<security.component:purl>"
                }
              },
              "row": {
                "name": "security.sbom-component",
                "version": 1,
                "digest": "sha256:04c4e110e39869026e7e4e74bbf4aca3bba92f21187c4783f544627872af67c6"
              },
              "fields": {
                "name": {
