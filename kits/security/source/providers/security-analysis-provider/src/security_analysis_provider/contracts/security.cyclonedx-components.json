{
  "interface_id": "security.cyclonedx-components",
  "version": 1,
  "effect_class": "pure",
  "contracts": {
    "input": {
      "fields": {
        "sbom_text": {
          "type": "string"
        },
        "releases": {
          "type": "json"
        },
        "osv_ecosystems": {
          "type": "json",
          "optional": true,
          "default": {}
        }
      },
      "allow_extra": false
    },
    "output": {
      "fields": {
        "items": {
          "type": "json"
        },
        "changed": {
          "type": "integer"
        },
        "product": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "components": {
          "type": "integer"
        },
        "added": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "osv_not_indexed": {
          "type": "json"
        },
        "osv_unindexed": {
          "type": "integer"
        }
      },
      "allow_extra": false
    }
  },
  "refusals": [
    "provider_declined"
  ]
}
