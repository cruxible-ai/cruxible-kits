{
  "interface_id": "security.runtime-inventory",
  "version": 1,
  "effect_class": "pure",
  "contracts": {
    "input": {
      "fields": {
        "inventory_text": {
          "type": "string"
        },
        "held": {
          "type": "json"
        },
        "runs": {
          "type": "json"
        },
        "patches": {
          "type": "json"
        },
        "scope": {
          "type": "string"
        },
        "truncated": {
          "type": "json"
        },
        "osv_ecosystems": {
          "type": "json",
          "optional": true,
          "default": {}
        },
        "asset": {
          "type": "string",
          "optional": true,
          "default": ""
        }
      },
      "allow_extra": false
    },
    "output": {
      "fields": {
        "items": {
          "type": "json"
        },
        "scope": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "regressions": {
          "type": "json"
        },
        "mine": {
          "type": "integer"
        },
        "assets": {
          "type": "integer"
        },
        "runs": {
          "type": "integer"
        },
        "unidentified": {
          "type": "integer"
        },
        "added": {
          "type": "integer"
        },
        "retired": {
          "type": "integer"
        },
        "revised": {
          "type": "integer"
        },
        "restated": {
          "type": "integer"
        },
        "verified": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "changed": {
          "type": "integer"
        },
        "proposes": {
          "type": "integer"
        },
        "nones": {
          "type": "integer"
        },
        "osv_not_indexed": {
          "type": "json"
        },
        "osv_unindexed": {
          "type": "integer"
        }
      },
      "allow_extra": false
    }
  },
  "refusals": [
    "provider_declined"
  ]
}
