{
  "kind": "change_set",
  "rationale": "Example consumer automation for the security kit (vulnerability loop, hardening questions, code-finding and incident imports); add your repositories and PyPI projects from intake.md; adapt before submitting.",
  "members": [
    {
      "kind": "acquisition_policy",
      "acquisition_policy": {
        "identity": {
          "kind": "SourceAcquisitionPolicy",
          "name": "default"
        },
        "max_age": "P1D"
      }
    },
    {
      "kind": "line",
      "name": "security.kev-daily",
      "procedure_name": "security.fetch-observed",
      "max_authority": "observe",
      "parameters": {
        "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
        "logical_source": "cisa.kev.catalog",
        "max_bytes": 4194304
      }
    },
    {
      "kind": "line",
      "name": "security.kev-triage",
      "procedure_name": "security.kev-triage",
      "max_authority": "propose",
      "trigger_input": "catalog"
    },
    {
      "kind": "line",
      "name": "security.kev-attention",
      "procedure_name": "security.kev-attention",
      "max_authority": "observe",
      "trigger_input": "catalog"
    },
    {
      "kind": "line",
      "name": "security.epss-daily",
      "procedure_name": "security.epss-acquire",
      "max_authority": "observe"
    },
    {
      "kind": "line",
      "name": "security.epss-triage",
      "procedure_name": "security.epss-triage",
      "max_authority": "propose",
      "trigger_input": "epss"
    },
    {
      "kind": "line",
      "name": "security.sbom-import",
      "procedure_name": "security.sbom-import",
      "max_authority": "propose",
      "trigger_input": "sbom"
    },
    {
      "kind": "line",
      "name": "security.osv-applicability",
      "procedure_name": "security.osv-applicability",
      "max_authority": "propose"
