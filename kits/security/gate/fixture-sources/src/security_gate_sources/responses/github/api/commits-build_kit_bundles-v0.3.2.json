[{"sha":"6354e15bace2e97efa618a39d955b570ca5a6ee1","node_id":"C_kwDORd2ndtoAKDYzNTRlMTViYWNlMmU5N2VmYTYxOGEzOWQ5NTViNTcwY2E1YTZlZTE","commit":{"author":{"name":"Robert Malone","email":"rmalone1097@gmail.com","date":"2026-07-07T00:01:09Z"},"committer":{"name":"Robert Malone","email":"rmalone1097@gmail.com","date":"2026-07-07T00:01:09Z"},"message":"Fetch-by-digest kit distribution: published release bundles resolve kit aliases\n\nInstalled distributions (pip install, no source checkout) now resolve kit\naliases from digest-pinned GitHub release bundles. scripts/build_kit_bundles.py\nwrites byte-reproducible dist/kits/<id>-<version>.tar.gz archives (sorted\nmembers, mtime=0, uid/gid=0, no owner names, mode 0644, gzip mtime pinned) and\nregenerates the wheel-packaged kit_distribution/manifest.json pinning each\nbundle by tarball sha256 and extracted-directory compute_path_sha256 digest.\n\nresolve_published_kit verifies the tarball sha256 before extraction,\nsafe-extracts (files/dirs only, no absolute paths, .., or links; data filter\nwhen available; download and extraction size caps), verifies the directory\ndigest, and installs atomically into the kit cache keyed by that digest; a\ncache hit skips the network. Alias order: local source checkout wins, then\npublished bundles, then shipped oci refs; overlay target_state bases resolve\nthrough the same seam. CRUXIBLE_KIT_MANIFEST_URL_BASE overrides base_url for\nsmoke runs; the packaged base_url must be https. All failures are fail-closed\nwith the expected/actual digests and the git-clone fallback named.","tree":{"sha":"355ea17147aaf6b3bbf5b0068c9263509b75beef","url":"https://api.github.com/repos/cruxible-ai/cruxible/git/trees/355ea17147aaf6b3bbf5b0068c9263509b75beef"},"url":"https://api.github.com/repos/cruxible-ai/cruxible/git/commits/6354e15bace2e97efa618a39d955b570ca5a6ee1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.g