{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 100,
    "max_traversal_depth": 10
  },
  "description": "The parts that fit one vehicle.",
  "entry": {
    "binding": "part",
    "subject_kinds": [
      "catalog.part"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "catalog.parts_for_vehicle"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 1000,
    "max_traversal_depth": 10
  },
  "parameters": [
    {
      "name": "vehicle",
      "value_type": "string"
    }
  ],
  "projection": {
    "fields": [
      {
        "name": "category",
        "value": {
          "binding": "part",
          "kind": "claim_value",
          "predicate": "catalog.part.category"
        }
      },
      {
        "name": "title",
        "value": {
          "binding": "part",
          "kind": "claim_value",
          "predicate": "catalog.part.title"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "vehicle",
      "direction": "forward",
      "from_binding": "part",
      "predicate": "catalog.part.fits",
      "target_subject_kinds": [
        "catalog.vehicle"
      ]
    }
  ],
  "where": {
    "kind": "comparison",
    "left": {
      "binding": "vehicle",
      "kind": "claim_value",
      "predicate": "catalog.vehicle.name"
    },
    "operator": "eq",
    "right": {
      "kind": "parameter",
      "parameter": "vehicle"
    },
    "value_type": "string"
  }
}
