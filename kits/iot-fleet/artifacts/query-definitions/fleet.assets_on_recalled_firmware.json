{
  "artifact_format": "cruxible-query-definition-v3",
  "dedupe": "path",
  "default_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 100,
    "max_results": 200,
    "max_traversal_depth": 10
  },
  "description": "Assets running deprecated or recalled firmware.",
  "entry": {
    "binding": "asset",
    "subject_kinds": [
      "fleet.asset"
    ]
  },
  "evaluation_policy": {
    "conflict_behavior": "surface_conflicts",
    "visible_currency": [
      "current"
    ],
    "visible_verdicts": [
      "supported"
    ]
  },
  "identity": {
    "kind": "QueryDefinition",
    "name": "fleet.assets_on_recalled_firmware"
  },
  "maximum_budgets": {
    "max_paths": 20000,
    "max_paths_per_result": 1000,
    "max_results": 2000,
    "max_traversal_depth": 10
  },
  "projection": {
    "fields": [
      {
        "name": "asset_type",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "fleet.asset.asset_type"
        }
      },
      {
        "name": "criticality",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "fleet.asset.criticality"
        }
      },
      {
        "name": "firmware_status",
        "value": {
          "binding": "fw",
          "kind": "claim_value",
          "predicate": "fleet.firmware.status"
        }
      },
      {
        "name": "fw",
        "value": {
          "binding": "fw",
          "field": "subject_id",
          "kind": "subject_field"
        }
      },
      {
        "name": "site",
        "value": {
          "binding": "asset",
          "kind": "claim_value",
          "predicate": "fleet.asset.site"
        }
      }
    ]
  },
  "result_shape": "path",
  "traversal": [
    {
      "binding": "fw",
      "direction": "forward",
      "from_binding": "asset",
      "predicate": "fleet.asset.firmware",
      "target_subject_kinds": [
        "fleet.firmware"
      ],
      "where": {
        "kind": "comparison",
        "left": {
          "binding": "fw",
          "kind": "claim_value",
          "predicate": "fleet.firmware.status"
        },
        "operator": "gte",
        "right": {
          "kind": "literal",
          "value": "deprecated"
        },
        "value_type": "string"
      }
    }
  ]
}
