{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "fleet.telemetry-ingest.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "fleet.telemetry-ingest.output/v1"
      }
    },
    "description": "Read one hub telemetry batch from the workspace, filter and classify each sensor against approved fleet.baseline bounds via EWMA gain filtering, emit one derived fleet.telemetry-analysis Capture, and settle fleet.asset.operating_state.",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 50000,
      "max_provider_calls": 2,
      "max_read_rows": 20000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "fleet.telemetry-ingest",
    "nodes": [
      {
        "id": "baselines",
        "kind": "read",
        "query": {
          "target": {
            "kind": "QueryDefinition",
            "name": "fleet.approved_baselines"
          }
        }
      },
      {
        "captures": {
          "capture": {
            "target": {
              "kind": "CaptureContract",
              "name": "fleet.telemetry-batch"
            }
          }
        },
        "id": "batch",
        "input": {
          "logical_source": "$params.logical_source",
          "relative_path": "$params.relative_path"
        },
        "kind": "call",
        "slot": "read"
      },
      {
        "captures": {
          "document": {
            "target": {
              "kind": "CaptureContract",
              "name": "fleet.telemetry-analysis"
            }
          }
        },
        "id": "analysis",
        "input": {
          "alpha": "$params.alpha",
          "baselines": "$steps.baselines.rows",
          "batches": [
            "$steps.batch.capture"
          ],
          "flatline_samples": "$params.flatline_samples",
          "logical_source": "$params.logical_source",
          "max_heartbeat_age_s": "$params.max_heartbeat_age_s",
          "min_breach_samples": "$params.min_breach_samples"
        },
        "kind": "call",
        "slot": "derive"
      },
      {
        "capture": "$steps.analysis.document",
        "id": "assets",
        "kind": "extract",
        "records": "assets",
        "row": {
          "digest": "sha256:f2471a3bb98f3ab9315695bc2e354150a7b1dad02e73534eed65c498f1c49b2d",
          "name": "fleet.telemetry-asset-row",
          "version": 1
        }
      },
      {
        "claims": [
          {
            "rationale": "{$item.fields.reason}",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "fleet.asset.operating_state"
              }
            },
            "value": "$item.fields.operating_state"
          }
        ],
        "for_each": "$steps.assets.records",
        "id": "write",
        "kind": "claims",
        "subject": {
          "key": {
            "name": "$item.key.name"
          },
          "kind": "fleet.asset"
        }
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "fleet.telemetry-ingest.params/v1"
      }
    },
    "slots": {
      "derive": {
        "capability": {
          "digest": "sha256:6a8a7002a68b15556b572332790a627299d58165696eb3efbbcb9c043a8a8490",
          "name": "fleet.telemetry.analyze",
          "version": 1
        }
      },
      "read": {
        "capability": {
          "digest": "sha256:bf3721f916492c908d0db48103a457caad6b2f58c6ad0babc92470a0fdccea5e",
          "name": "workspace.file",
          "version": 1
        }
      }
    },
    "terminal_capability": 3
  },
  "definition_digest": "sha256:dba93f57c1662c24a98b4208cc8b651a692e9fe6db05013aa84eeb44fd721f24",
  "identity": {
    "kind": "Procedure",
    "name": "fleet.telemetry-ingest"
  }
}
