{
  "activation_policy": "snapshot",
  "artifact_format": "cruxible-procedure-v4",
  "definition": {
    "contract_in": {
      "target": {
        "kind": "Contract",
        "name": "fleet.sensor-health.input/v1"
      }
    },
    "contract_out": {
      "target": {
        "kind": "Contract",
        "name": "fleet.sensor-health.output/v1"
      }
    },
    "description": "Settle fleet.sensor.status from one landed fleet.telemetry-analysis Capture (substituted by its landing Trigger without re-running the derive).",
    "hard_caps": {
      "max_capture_bytes": 16777216,
      "max_items": 50000,
      "max_provider_calls": 1,
      "max_read_rows": 20000,
      "max_repeat_attempts": 1,
      "max_wall_clock": {
        "microseconds": 120000000
      }
    },
    "name": "fleet.sensor-health",
    "nodes": [
      {
        "captures": {
          "document": {
            "target": {
              "kind": "CaptureContract",
              "name": "fleet.telemetry-analysis"
            }
          }
        },
        "id": "analysis",
        "input": {
          "alpha": "0.3",
          "baselines": [],
          "batches": [],
          "flatline_samples": 5,
          "logical_source": "$params.logical_source",
          "max_heartbeat_age_s": 1800,
          "min_breach_samples": 3
        },
        "kind": "call",
        "slot": "derive"
      },
      {
        "capture": "$steps.analysis.document",
        "id": "sensors",
        "kind": "extract",
        "records": "sensors",
        "row": {
          "digest": "sha256:39e48b29e3150971bff3d6daa843367fb3997ed3dcd7178bdd3f49a52cea1e32",
          "name": "fleet.telemetry-sensor-row",
          "version": 1
        }
      },
      {
        "claims": [
          {
            "rationale": "{$item.fields.reason}",
            "type": {
              "target": {
                "kind": "ClaimType",
                "name": "fleet.sensor.status"
              }
            },
            "value": "$item.fields.status"
          }
        ],
        "for_each": "$steps.sensors.records",
        "id": "write",
        "kind": "claims",
        "subject": {
          "key": {
            "name": "$item.key.name"
          },
          "kind": "fleet.sensor"
        }
      }
    ],
    "parameter_contract": {
      "target": {
        "kind": "Contract",
        "name": "fleet.sensor-health.params/v1"
      }
    },
    "slots": {
      "derive": {
        "capability": {
          "digest": "sha256:6a8a7002a68b15556b572332790a627299d58165696eb3efbbcb9c043a8a8490",
          "name": "fleet.telemetry.analyze",
          "version": 1
        }
      }
    },
    "terminal_capability": 3
  },
  "definition_digest": "sha256:bcd943ca7c16f0266a6d54eb200caa13f4932ab3468e5d596098e0f37bce3475",
  "identity": {
    "kind": "Procedure",
    "name": "fleet.sensor-health"
  }
}
