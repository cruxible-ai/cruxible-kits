   },
   "parameters": {
    "logical_source": "fleet.telemetry.{{name}}"
   },
   "trigger_input": "analysis.document",
   "acquisition": {
    "analysis.document": {}
   },
   "findings": {
    "inbox": [
     "extract_refused",
     "duplicate_key",
     "incomplete_source",
     "held_disagrees",
     "slot_contested"
    ]
   },
   "max_authority": "settle"
  },
  {
   "kind": "procedure_mandate",
