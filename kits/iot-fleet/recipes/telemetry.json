{
 "kind": "change_set",
 "rationale": "kit adopt iot-fleet:telemetry: hub telemetry ingest Line fleet.telemetry-ingest.{{name}} reading {{relative_path}} with EWMA gain {{alpha}}, its capture-landing sensor-health and anomaly-ingest Lines, and scope: observations Mandates valid for {{expires}}.",
 "members": [
  {
   "kind": "line",
   "name": "fleet.telemetry-ingest.{{name}}",
   "procedure_name": "fleet.telemetry-ingest",
   "bindings": {
    "read": "cruxible-builtin#workspace.file",
    "derive": "iot-telemetry-provider#telemetry.analyze"
   },
   "parameters": {
    "relative_path": "{{relative_path}}",
    "logical_source": "fleet.telemetry.{{name}}",
    "alpha": "{{alpha}}",
    "min_breach_samples": "{{min_breach_samples}}",
    "flatline_samples": "{{flatline_samples}}",
    "max_heartbeat_age_s": "{{max_heartbeat_age_s}}"
   },
   "acquisition": {},
   "findings": {
    "inbox": [
     "extract_refused",
     "duplicate_key",
     "incomplete_source",
     "held_disagrees",
     "slot_contested"
    ]
   },
   "max_authority": "settle"
  },
  {
   "kind": "procedure_mandate",
   "name": "fleet.telemetry-ingest.{{name}}-propose",
   "line_name": "fleet.telemetry-ingest.{{name}}",
   "grants": "propose",
   "namespace": [
    "claims"
   ],
   "expires": "{{expires}}"
  },
  {
   "kind": "procedure_mandate",
   "name": "fleet.telemetry-ingest.{{name}}-settle",
   "line_name": "fleet.telemetry-ingest.{{name}}",
   "grants": "settle",
   "scope": "observations",
   "expires": "{{expires}}"
  },
  {
   "kind": "line",
