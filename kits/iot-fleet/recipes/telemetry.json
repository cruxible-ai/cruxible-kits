   "line_name": "fleet.sensor-health.{{name}}",
   "grants": "settle",
   "scope": "observations",
   "expires": "{{expires}}"
  },
  {
   "kind": "trigger",
   "name": "fleet.sensor-health-on-analysis.{{name}}",
   "line_name": "fleet.sensor-health.{{name}}",
   "schedule": {
    "kind": "capture_landing",
    "capture_contract": "fleet.telemetry-analysis",
    "logical_sources": [
     "fleet.telemetry.{{name}}"
    ]
   }
  },
  {
   "kind": "line",
   "name": "fleet.anomaly-ingest.{{name}}",
